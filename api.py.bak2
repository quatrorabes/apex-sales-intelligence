@app.route('/api/contacts/<int:contact_id>/enrich', methods=['POST'])
def enrich_contact(contact_id):
    """Enrich a contact using Perplexity AI"""
    try:
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM contacts WHERE id = %s", (contact_id,))
        row = cursor.fetchone()
        
        if not row:
            conn.close()
            return jsonify({"success": False, "error": "Contact not found"}), 404
        
        contact = dict(row)
        conn.close()
        
        # Build search query
        name = f"{contact.get('firstname', '')} {contact.get('lastname', '')}".strip()
        company = contact.get('company', '')
        title = contact.get('title', '') or contact.get('job_title', '')
        linkedin = contact.get('linkedin_url', '') or contact.get('linkedin', '')
        
        logger.info(f"🔍 Enriching: {name} at {company}")
        
        # Check for Perplexity API
        perplexity_key = os.getenv('PERPLEXITY_API_KEY')
        if not perplexity_key:
            return jsonify({"success": False, "error": "No Perplexity API key"}), 500
        
        # Build comprehensive prompt
        search_context = f"{name}"
        if company:
            search_context += f" {company}"
        if title:
            search_context += f" {title}"
        if linkedin:
            search_context += f" LinkedIn: {linkedin}"
        
        prompt = f"""Research this business professional and provide a comprehensive profile:

**{name}**
- Company: {company or 'Unknown'}
- Title: {title or 'Unknown'}
- LinkedIn: {linkedin or 'Not provided'}

Please provide:
1. **Professional Background** - Career history, current role, responsibilities
2. **Company Overview** - What their company does, size, industry position
3. **Industry Context** - Market trends, challenges in their sector
4. **Communication Style** - Based on any public content, how they communicate
5. **Potential Pain Points** - Business challenges someone in this role typically faces
6. **Talking Points** - Topics that would resonate based on their background
7. **Recent Activity** - Any recent news, posts, or company updates

Be specific and factual. If information isn't available, note that."""

        # Call Perplexity
        headers = {
            "Authorization": f"Bearer {perplexity_key}",
            "Content-Type": "application/json"
        }
        
        payload = {
            "model": "sonar-pro",
            "messages": [
                {"role": "system", "content": "You are a professional research analyst. Provide detailed, factual profiles of business professionals."},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.2,
            "max_tokens": 4000
        }
        
        response = requests.post(
            "https://api.perplexity.ai/chat/completions",
            headers=headers,
            json=payload,
            timeout=60
        )
        
        if response.status_code != 200:
            logger.error(f"Perplexity error: {response.status_code} - {response.text}")
            return jsonify({"success": False, "error": f"Perplexity API error: {response.status_code}"}), 500
        
        result = response.json()
        profile_text = result.get('choices', [{}])[0].get('message', {}).get('content', '')
        
        if not profile_text:
            return jsonify({"success": False, "error": "Empty response from Perplexity"}), 500
        
        # Save to database
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute("""
            UPDATE contacts SET
            profile_content = %s,
            enrichment_status = %s,
            enriched_at = %s
            WHERE id = %s
        """, (profile_text, 'completed', datetime.now().isoformat(), contact_id))
        conn.commit()
        conn.close()
        
        logger.info(f"✅ Enrichment complete for {name} ({len(profile_text)} chars)")
        
        return jsonify({
            'success': True,
            'contact_id': contact_id,
            'profile_length': len(profile_text)
        }), 200
        
    except Exception as e:
        logger.error(f"❌ Enrichment error: {e}")
        try:
            conn = get_db()
            conn.cursor().execute("UPDATE contacts SET enrichment_status = %s WHERE id = %s", ('failed', contact_id))
            conn.commit()
            conn.close()
        except:
            pass
        return jsonify({"success": False, "error": str(e)}), 500

    # ============================================================
    # CONTACT REFRESH ENDPOINT - Apex v2.0 Railway Edition
    # ============================================================
    @app.route('/api/contacts/<int:contact_id>/refresh', methods=['POST'])
    def refresh_contact(contact_id):
        """
        Refreshes a contact after enrichment for Railway/PostgreSQL.
        Re-fetches vital HubSpot fields and repopulates dashboard data.
        
        Returns: {success: bool, contact: {...}, message: str, last_refreshed: str}
        """
        try:
            # 1. Get DB connection (Railway Postgres)
            conn = get_db()
            cursor = conn.cursor()
            
            # 2. Fetch contact - PostgreSQL uses %s placeholders
            ph = get_placeholder()
        cursor.execute(f"SELECT * FROM contacts WHERE id = {ph}", (contact_id,))
            contact = cursor.fetchone()
            
            if not contact:
                conn.close()
                return jsonify(success=False, error="Contact not found.", contact_id=contact_id), 404
            
            # Convert to dict (assuming you have dict_factory or similar)
            if hasattr(cursor, 'description'):
                columns = [col[0] for col in cursor.description]
                contact_dict = dict(zip(columns, contact))
            else:
                contact_dict = dict(contact)
                
            # 3. Re-enrich if enrichment engine available
            enrichment_attempted = False
            if enrichment_engine:
                try:
                    enriched_data = enrichment_engine.enrich_contact(contact_dict)
                    
                    cursor.execute("""
                        UPDATE contacts 
                        SET 
                            profilecontent = %s, 
                            enrichmentstatus = 'completed',
                            enrichmentdata = %s,
                            updatedat = %s
                        WHERE id = %s
                    """, (
                        enriched_data.get("profilecontent"),
                        enriched_data.get("enrichmentdata_json"),
                        datetime.now().isoformat(),
                        contact_id
                    ))
                    conn.commit()
                    logger.info(f"✅ Contact {contact_id} re-enriched")
                    enrichment_attempted = True
                    
                except Exception as enrich_err:
                    logger.warning(f"⚠️ Enrichment failed during refresh: {enrich_err}")
                    
            # 4. Re-score if scoring engine available
            scoring_attempted = False
            if scoring_engine:
                try:
                    ph = "%s" if IS_POSTGRES else "?"
                    cursor.execute(f"SELECT * FROM contacts WHERE id = {ph}", (contact_id,))
                    updated_row = cursor.fetchone()
                    
                    if updated_row:
                        columns = [col[0] for col in cursor.description]
                        updated_contact = dict(zip(columns, updated_row))
                        scores = scoring_engine.score_contact(updated_contact)
                        
                        cursor.execute("""
                            UPDATE contacts 
                            SET 
                                mdcpscore = %s, 
                                rssscore = %s, 
                                priorityscore = %s,
                                mdcptier = %s,
                                rsstier = %s,
                                urgencylevel = %s,
                                lastscored = %s
                            WHERE id = %s
                        """, (
                            scores.get("mdcp_score"),
                            scores.get("rss_score"),
                            scores.get("priority_score"),
                            scores.get("mdcp_tier"),
                            scores.get("rss_tier"),
                            scores.get("urgency_level"),
                            datetime.now().isoformat(),
                            contact_id
                        ))
                        conn.commit()
                        logger.info(f"✅ Contact {contact_id} re-scored")
                        scoring_attempted = True
                        
                except Exception as score_err:
                    logger.warning(f"⚠️ Scoring failed during refresh: {score_err}")
                    
            # 5. Fetch final refreshed contact with ALL vital fields
            cursor.execute("""
                SELECT 
                    id, name, firstname, lastname, email, phone, company, title, 
                    hubspotid, linkedinurl, enrichmentstatus, profilecontent, 
                    mdcpscore, rssscore, priorityscore, mdcptier, rsstier, urgencylevel,
                    lifecyclestage, leadstatus, lastcontactdate, lastscored,
                    email1subject, email1body, callscript1, linkedinconnect,
                    updatedat, createdat
                FROM contacts 
                WHERE id = %s
            """, (contact_id,))
            
            final_row = cursor.fetchone()
            columns = [col[0] for col in cursor.description]
            refreshed_contact = dict(zip(columns, final_row))
            
            conn.close()
            
            return jsonify(
                success=True,
                contact=refreshed_contact,
                message="Contact refreshed successfully (Railway/Postgres).",
                last_refreshed=refreshed_contact['updatedat'],
                enrichment_attempted=enrichment_attempted,
                scoring_attempted=scoring_attempted
            ), 200
        
        except Exception as e:
            logger.error(f"❌ [Apex/Railway] Refresh error for contact {contact_id}: {str(e)}")
            import traceback
            logger.error(traceback.format_exc())
            return jsonify(success=False, error=str(e)), 500
        

