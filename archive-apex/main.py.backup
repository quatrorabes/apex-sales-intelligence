@app.post("/api/contacts/bulk/enrich")
async def bulk_enrich_contacts(contact_ids: List[int], background_tasks: BackgroundTasks):
    """Enrich multiple contacts"""
    try:
        with get_db() as conn:
            cursor = conn.cursor()
            
            # Update all to 'enriching' status
            placeholders = ','.join('?' * len(contact_ids))
            cursor.execute(f"""
                UPDATE contacts
                SET enrichment_status = 'enriching',
                    updated_at = ?
                WHERE id IN ({placeholders})
            """, [datetime.now().isoformat()] + contact_ids)
            conn.commit()
            
            # TODO: Add background tasks for actual enrichment
            
            return {
                "status": "success",
                "message": f"Bulk enrichment initiated for {len(contact_ids)} contacts",
                "contact_ids": contact_ids
            }
            
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

