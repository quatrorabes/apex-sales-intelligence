import React, { useState, useEffect } from 'react';

interface Contact {
  id: number;
  name: string;
  firstname?: string;
  lastname?: string;
  email: string;
  phone?: string;
  company?: string;
  title?: string;
  linkedin_url?: string;
  enrichment_status?: string;
  enrichment_data?: string;
  profile_content?: string;
  enrichment_count?: number;
  last_enriched_at?: string;
  enrichment_date?: string;
  mdcp_score?: number;
  rss_score?: number;
  priority_score?: number;
  urgency_level?: string;
  mdcp_tier?: string;
  rss_tier?: string;
  persona_type?: string;
  persona_tier?: string;
  recommended_action?: string;
  lead_status?: string;
  lifecycle_stage?: string;
  relationship_level?: string;
  email_1_subject?: string;
  email_1_body?: string;
  email_2_subject?: string;
  email_2_body?: string;
  email_3_subject?: string;
  email_3_body?: string;
  call_script_1?: string;
  call_script_2?: string;
  call_script_3?: string;
  linkedin_request?: string;
  linkedin_followup?: string;
  content_generated_at?: string;
}

interface ContactDetailModalProps {
  contact: Contact;
  onClose: () => void;
  onUpdate?: () => void;
  onEnrich?: (contactId: number) => void;
}

interface ParsedIntelligence {
  // Personal Profile
  overview: string;
  background: string[];
  education: string[];
  recent_mentions: string[];
  professional_network: string[];
  
  // Company Profile
  company_overview: string;
  company_products: string[];
  company_leadership: string[];
  company_news: string[];
  company_financials: string;
  
  // Personality
  personality_assessment: string;
  mbti_type: string;
  key_traits: string[];
  
  // Chat Things (Strategic Intelligence)
  pain_points: string[];
  sba_interests: string[];
  key_insights: string[];
  sales_talking_points: string[];
}

const ContactDetailModal: React.FC<ContactDetailModalProps> = ({
  contact,
  onClose,
  onUpdate,
  onEnrich
}) => {
  const [activeTab, setActiveTab] = useState<'overview' | 'personal' | 'company' | 'personality' | 'chat-things' | 'content'>('overview');
  const [rawIntelligence, setRawIntelligence] = useState<string>('');
  const [parsedSections, setParsedSections] = useState<ParsedIntelligence>({
    overview: '',
    background: [],
    education: [],
    recent_mentions: [],
    professional_network: [],
    company_overview: '',
    company_products: [],
    company_leadership: [],
    company_news: [],
    company_financials: '',
    personality_assessment: '',
    mbti_type: '',
    key_traits: [],
    pain_points: [],
    sba_interests: [],
    key_insights: [],
    sales_talking_points: []
  });
  const [generatedContent, setGeneratedContent] = useState<any>({
    email: [
      { subject: '', body: '' },
      { subject: '', body: '' },
      { subject: '', body: '' }
    ],
    call: ['', '', ''],
    linkedin: ['', '']
  });
  const [isGenerating, setIsGenerating] = useState(false);
  const [generationError, setGenerationError] = useState('');
  const [copiedField, setCopiedField] = useState('');

  // Check if contact is enriched
  const isEnriched = Boolean(contact.profile_content) || contact.enrichment_status === 'complete';
  const enrichmentDate = contact.last_enriched_at || contact.enrichment_date;
  const enrichmentCount = contact.enrichment_count || 0;

  // Parse enrichment data on mount
  useEffect(() => {
    if (contact.profile_content) {
      setRawIntelligence(contact.profile_content);
      const sections = parseProfileSections(contact.profile_content);
      setParsedSections(sections);
    } else if (contact.enrichment_data) {
      try {
        const parsed = JSON.parse(contact.enrichment_data);
        if (parsed.full_profile_text || parsed.perplexity_insights) {
          const text = parsed.full_profile_text || parsed.perplexity_insights;
          setRawIntelligence(text);
          const sections = parseProfileSections(text);
          setParsedSections(sections);
        }
      } catch (e) {
        console.error('Failed to parse enrichment data:', e);
      }
    }

    // Load existing generated content
    if (contact.email_1_subject || contact.email_1_body) {
      setGeneratedContent({
        email: [
          { subject: contact.email_1_subject || '', body: contact.email_1_body || '' },
          { subject: contact.email_2_subject || '', body: contact.email_2_body || '' },
          { subject: contact.email_3_subject || '', body: contact.email_3_body || '' }
        ],
        call: [
          contact.call_script_1 || '',
          contact.call_script_2 || '',
          contact.call_script_3 || ''
        ],
        linkedin: [
          contact.linkedin_request || '',
          contact.linkedin_followup || ''
        ]
      });
    }
  }, [contact]);

  const cleanText = (text: string): string => {
    return text
      .replace(/\*\*/g, '')                    // Remove bold **
      .replace(/\*([^*]+)\*/g, '$1')           // Remove single asterisks
      .replace(/\[(\d+)\]/g, '')               // Remove citation numbers [1], [2]
      .replace(/\[(.*?)\]/g, '$1')             // Remove brackets but keep content
      .replace(/_([^_]+)_/g, '$1')             // Remove underscores used for italics
      .replace(/\n\s*[-•]\s*/g, '\n')          // Clean up list markers
      .replace(/\s+/g, ' ')                    // Normalize whitespace
      .trim();
  };

  const parseProfileSections = (text: string): ParsedIntelligence => {
    const sections: ParsedIntelligence = {
      overview: '',
      background: [],
      education: [],
      recent_mentions: [],
      professional_network: [],
      company_overview: '',
      company_products: [],
      company_leadership: [],
      company_news: [],
      company_financials: '',
      personality_assessment: '',
      mbti_type: '',
      key_traits: [],
      pain_points: [],
      sba_interests: [],
      key_insights: [],
      sales_talking_points: []
    };
    
    // Helper to clean markdown and URLs
    const cleanText = (str: string) => 
      str.replace(/\*\*/g, '')
          .replace(/###?/g, '')
          .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')  // Keep link text, remove URL
          .trim();
    
    // PERSON PROFILE - Consistent numbered sections
    const overviewMatch = text.match(/###\s*1\.\s*Overview[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (overviewMatch) sections.overview = cleanText(overviewMatch[1]);
    
    const backgroundMatch = text.match(/###\s*2\.\s*Background[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (backgroundMatch) {
      sections.background = backgroundMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 20);
    }
    
    const educationMatch = text.match(/###\s*3\.\s*Education[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (educationMatch) {
      sections.education = educationMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 5);
    }
    
    const recentMatch = text.match(/###\s*4\.\s*Recent Mentions[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (recentMatch) {
      sections.recent_mentions = recentMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 20);
    }
    
    const socialMatch = text.match(/###\s*5\.\s*Social Profiles[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (socialMatch) {
      sections.professional_network = socialMatch[1]
        .split(/\n\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 10 && (s.includes('LinkedIn') || s.includes('Twitter') || s.includes('Facebook') || s.includes('Instagram')));
    }
    
    // PERSONALITY - Sections 6 & 7
    const personalityDetailMatch = text.match(/###\s*6\.\s*Personality Detail[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    const personalitySummaryMatch = text.match(/###\s*7\.\s*Myers-Briggs.*?Summary[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    
    if (personalityDetailMatch || personalitySummaryMatch) {
      const personalityText = (personalityDetailMatch ? personalityDetailMatch[1] : '') + '\n' + 
                              (personalitySummaryMatch ? personalitySummaryMatch[1] : '');
      sections.personality_assessment = cleanText(personalityText);
      
      // Extract MBTI type
      const mbtiMatch = personalityText.match(/\b(INTJ|INTP|ENTJ|ENTP|INFJ|INFP|ENFJ|ENFP|ISTJ|ISFJ|ESTJ|ESFJ|ISTP|ISFP|ESTP|ESFP)\b/);
      if (mbtiMatch) sections.mbti_type = mbtiMatch[1];
    }
    
    // SALES TALKING POINTS - Section 8
    const talkingPointsMatch = text.match(/###\s*8\.\s*Sales Opportunity[^\n]*\n+(.*?)(?=\n##\s*\*?\*?Company Profile|---)/is);
    if (talkingPointsMatch) {
      sections.sales_talking_points = talkingPointsMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 20);
    }
    
    // COMPANY PROFILE - After "## **Company Profile:" header
    const companyOverviewMatch = text.match(/##\s*\*?\*?Company Profile[^\n]*\n+###\s*1\.\s*Overview[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (companyOverviewMatch) sections.company_overview = cleanText(companyOverviewMatch[1]);
    
    const companyProductsMatch = text.match(/###\s*2\.\s*Products\s*&\s*Services[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (companyProductsMatch) {
      sections.company_products = companyProductsMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 20);
    }
    
    const companyLeadershipMatch = text.match(/###\s*3\.\s*Leadership[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (companyLeadershipMatch) {
      sections.company_leadership = companyLeadershipMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 10);
    }
    
    const companyMarketMatch = text.match(/###\s*4\.\s*Market\s*&\s*Competitors[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (companyMarketMatch) {
      sections.company_news = companyMarketMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 20);
    }
    
    const companyNewsMatch = text.match(/###\s*5\.\s*Recent News[^\n]*\n+(.*?)(?=\n###\s*\d+\.|---)/is);
    if (companyNewsMatch) {
      const newsItems = companyNewsMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 20);
      sections.company_news = [...(sections.company_news || []), ...newsItems];
    }
    
    const companyFunFactsMatch = text.match(/###\s*6\.\s*(?:Company\s*)?Fun Facts[^\n]*\n+(.*?)(?=\n##\s*STRATEGIC|---)/is);
    if (companyFunFactsMatch) sections.company_financials = cleanText(companyFunFactsMatch[1]);
    
    // STRATEGIC INTELLIGENCE SECTION - Always after "## STRATEGIC INTELLIGENCE SECTION"
    const painPointsMatch = text.match(/###\s*\*?\*?Pain Points\s*[–-][^\n]*\*?\*?\n+(.*?)(?=\n###\s*\*?\*?SBA|$)/is);
    if (painPointsMatch) {
      sections.pain_points = painPointsMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 20);
    }
    
    const sbaMatch = text.match(/###\s*\*?\*?SBA Financing Interest\s*[–-][^\n]*\*?\*?\n+(.*?)(?=\n###\s*\*?\*?Key Insights|$)/is);
    if (sbaMatch) {
      sections.sba_interests = sbaMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 20);
    }
    
    const insightsMatch = text.match(/###\s*\*?\*?Key Insights:\s*[^\n]*\*?\*?\n+(.*?)(?=---|\*\(Most details|$)/is);
    if (insightsMatch) {
      sections.key_insights = insightsMatch[1]
        .split(/\n\s*[-•]\s*/)
        .map(s => cleanText(s))
        .filter(s => s.length > 20);
    }
    
    return sections;
  };
  

  const handleEnrich = async () => {
    if (onEnrich) {
      await onEnrich(contact.id);
      if (onUpdate) onUpdate();
    }
  };

  const handleGenerateAllContent = async () => {
    setIsGenerating(true);
    setGenerationError('');

    try {
      // Call the Python script via backend API endpoint
      const response = await fetch(`http://localhost:8000/api/contacts/${contact.id}/generate-content-unified`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error || 'Generation failed');
      }

      const data = await response.json();
      
      if (data.success) {
        // Reload contact data to get generated content
        if (onUpdate) await onUpdate();
        
        // Update local state
        setGeneratedContent({
          email: [
            { subject: data.emails?.email_1?.subject || '', body: data.emails?.email_1?.body || '' },
            { subject: data.emails?.email_2?.subject || '', body: data.emails?.email_2?.body || '' },
            { subject: data.emails?.email_3?.subject || '', body: data.emails?.email_3?.body || '' }
          ],
          call: [
            data.scripts?.script_1_cold_call || '',
            data.scripts?.script_2_followup || '',
            data.scripts?.script_3_executive || ''
          ],
          linkedin: [
            data.linkedin?.connection_note || '',
            data.linkedin?.followup_message || ''
          ]
        });

        setActiveTab('content');
      }
    } catch (error: any) {
      console.error('Content generation error:', error);
      setGenerationError(error.message);
    } finally {
      setIsGenerating(false);
    }
  };

  const copyText = (text: string, field: string) => {
    navigator.clipboard.writeText(text);
    setCopiedField(field);
    setTimeout(() => setCopiedField(''), 2000);
  };

  const formatDate = (dateStr?: string) => {
    if (!dateStr) return 'Never';
    try {
      const date = new Date(dateStr);
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return dateStr;
    }
  };

  const isPeer = contact.relationship_level === 'peer' || contact.persona_type?.includes('Referral');

  const getScoreColor = (score: number) => {
    if (score >= 70) return '#10b981';
    if (score >= 50) return '#f59e0b';
    return '#ef4444';
  };

  const getUrgencyColor = (urgency: string) => {
    switch (urgency?.toUpperCase()) {
      case 'IMMEDIATE': return '#ef4444';
      case 'HIGH': return '#f59e0b';
      case 'MEDIUM': return '#3b82f6';
      default: return '#6b7280';
    }
  };

  return (
    <div style={{
      position: 'fixed',
      top: 0,
      left: 0,
      right: 0,
      bottom: 0,
      backgroundColor: 'rgba(0, 0, 0, 0.75)',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
      zIndex: 1000,
      padding: '20px'
    }}>
      <div style={{
        backgroundColor: '#0a0f1f',
        borderRadius: '12px',
        maxWidth: '1200px',
        width: '100%',
        maxHeight: '90vh',
        overflow: 'hidden',
        display: 'flex',
        flexDirection: 'column',
        border: '1px solid #1e293b'
      }}>
        
        {/* Header with Gradient */}
        <div style={{
          background: 'linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)',
          padding: '24px 32px',
          color: 'white',
          position: 'relative'
        }}>
          <button
            onClick={onClose}
            style={{
              position: 'absolute',
              top: '20px',
              right: '20px',
              background: 'rgba(255, 255, 255, 0.2)',
              border: 'none',
              borderRadius: '6px',
              color: 'white',
              fontSize: '20px',
              width: '32px',
              height: '32px',
              cursor: 'pointer',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center'
            }}
          >
            ✕
          </button>

          <div style={{ display: 'flex', alignItems: 'flex-start', gap: '16px' }}>
            <div style={{
              width: '60px',
              height: '60px',
              borderRadius: '50%',
              background: 'rgba(255, 255, 255, 0.2)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              fontSize: '24px',
              fontWeight: 'bold'
            }}>
              {contact.name?.charAt(0) || '?'}
            </div>

            <div style={{ flex: 1 }}>
              <h2 style={{ margin: 0, fontSize: '24px', fontWeight: '600' }}>
                {contact.name}
              </h2>
              <p style={{ margin: '4px 0 0', opacity: 0.9, fontSize: '14px' }}>
                {contact.title} at {contact.company}
                {isPeer && <span style={{ marginLeft: '8px' }}>🤝 Referral Partner</span>}
              </p>

              {/* Score Badges */}
              <div style={{ display: 'flex', gap: '16px', marginTop: '16px' }}>
                <div style={{ textAlign: 'center' }}>
                  <div style={{ fontSize: '28px', fontWeight: 'bold' }}>
                    {contact.priority_score !== null ? Math.round(contact.priority_score) : '—'}
                  </div>
                  <div style={{ fontSize: '11px', opacity: 0.8, textTransform: 'uppercase' }}>Priority</div>
                </div>
                <div style={{ textAlign: 'center' }}>
                  <div style={{ fontSize: '28px', fontWeight: 'bold' }}>
                    {contact.mdcp_score !== null ? Math.round(contact.mdcp_score) : '—'}
                  </div>
                  <div style={{ fontSize: '11px', opacity: 0.8, textTransform: 'uppercase' }}>Role</div>
                </div>
                <div style={{ textAlign: 'center' }}>
                  <div style={{ fontSize: '28px', fontWeight: 'bold' }}>
                    {contact.rss_score !== null ? Math.round(contact.rss_score) : '—'}
                  </div>
                  <div style={{ fontSize: '11px', opacity: 0.8, textTransform: 'uppercase' }}>Data</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Tabs */}
        <div style={{
          display: 'flex',
          borderBottom: '1px solid #1e293b',
          backgroundColor: '#0f1629',
          padding: '0 32px',
          overflow: 'auto'
        }}>
          {[
            { id: 'overview', label: '📋 Overview' },
            { id: 'personal', label: '👤 Personal' },
            { id: 'company', label: '🏢 Company' },
            { id: 'personality', label: '🧠 Personality' },
            { id: 'chat-things', label: '💡 Chat Things' },
            { id: 'content', label: '✉️ Content' }
          ].map(tab => (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id as any)}
              style={{
                background: 'none',
                border: 'none',
                padding: '16px 20px',
                color: activeTab === tab.id ? '#6366f1' : '#94a3b8',
                fontSize: '14px',
                fontWeight: '500',
                cursor: 'pointer',
                borderBottom: activeTab === tab.id ? '2px solid #6366f1' : '2px solid transparent',
                transition: 'all 0.2s',
                whiteSpace: 'nowrap'
              }}
            >
              {tab.label}
            </button>
          ))}
        </div>

        {/* Content Area */}
        <div style={{
          flex: 1,
          overflow: 'auto',
          padding: '32px',
          backgroundColor: '#0a0f1f'
        }}>
          
          {/* OVERVIEW TAB */}
          {activeTab === 'overview' && (
            <OverviewTab 
              contact={contact}
              isEnriched={isEnriched}
              enrichmentDate={enrichmentDate}
              enrichmentCount={enrichmentCount}
              handleEnrich={handleEnrich}
              formatDate={formatDate}
              getScoreColor={getScoreColor}
              getUrgencyColor={getUrgencyColor}
            />
          )}

          {/* PERSONAL PROFILE TAB */}
          {activeTab === 'personal' && (
            <PersonalProfileTab 
              parsedSections={parsedSections}
              contact={contact}
              rawIntelligence={rawIntelligence}
            />
          )}

          {/* COMPANY PROFILE TAB */}
          {activeTab === 'company' && (
            <CompanyProfileTab 
              parsedSections={parsedSections}
              rawIntelligence={rawIntelligence}
            />
          )}

          {/* PERSONALITY TAB */}
          {activeTab === 'personality' && (
            <PersonalityTab 
              parsedSections={parsedSections}
              rawIntelligence={rawIntelligence}
            />
          )}

          {/* CHAT THINGS TAB */}
          {activeTab === 'chat-things' && (
            <ChatThingsTab 
              parsedSections={parsedSections}
              rawIntelligence={rawIntelligence}
            />
          )}

          {/* GENERATED CONTENT TAB */}
          {activeTab === 'content' && (
            <GeneratedContentTab
              isEnriched={isEnriched}
              isGenerating={isGenerating}
              generationError={generationError}
              generatedContent={generatedContent}
              handleGenerateAllContent={handleGenerateAllContent}
              copyText={copyText}
              copiedField={copiedField}
            />
          )}
        </div>
      </div>
    </div>
  );
};

// OVERVIEW TAB COMPONENT
const OverviewTab: React.FC<any> = ({
  contact,
  isEnriched,
  enrichmentDate,
  enrichmentCount,
  handleEnrich,
  formatDate,
  getScoreColor,
  getUrgencyColor
}) => (
  <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
    {/* Contact Info Card */}
    <div style={{
      backgroundColor: '#0f1629',
      border: '1px solid #1e293b',
      borderRadius: '8px',
      padding: '20px'
    }}>
      <h3 style={{ 
        margin: '0 0 16px', 
        color: '#e2e8f0', 
        fontSize: '16px',
        display: 'flex',
        alignItems: 'center',
        gap: '8px'
      }}>
        📇 Contact Information
      </h3>
      
      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '16px' }}>
        <InfoField label="EMAIL" value={contact.email} copyable />
        <InfoField label="PHONE" value={contact.phone || 'N/A'} copyable />
        <InfoField label="COMPANY" value={contact.company || 'N/A'} />
        <InfoField label="TITLE" value={contact.title || 'N/A'} />
      </div>
    </div>

    {/* Scoring Card */}
    <div style={{
      backgroundColor: '#0f1629',
      border: '1px solid #1e293b',
      borderRadius: '8px',
      padding: '20px'
    }}>
      <h3 style={{ 
        margin: '0 0 16px', 
        color: '#e2e8f0', 
        fontSize: '16px',
        display: 'flex',
        alignItems: 'center',
        gap: '8px'
      }}>
        🎯 Apex Scoring
      </h3>

      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: '16px' }}>
        <ScoreCard 
          label="MDCP Score"
          value={contact.mdcp_score}
          tier={contact.mdcp_tier}
          color={getScoreColor(contact.mdcp_score || 0)}
        />
        <ScoreCard 
          label="RSS Score"
          value={contact.rss_score}
          tier={contact.rss_tier}
          color={getScoreColor(contact.rss_score || 0)}
        />
        <ScoreCard 
          label="Priority"
          value={contact.priority_score}
          tier={contact.urgency_level}
          color={getUrgencyColor(contact.urgency_level || '')}
        />
      </div>

      {contact.recommended_action && (
        <div style={{
          marginTop: '16px',
          padding: '12px',
          backgroundColor: '#1e293b',
          borderRadius: '6px',
          color: '#94a3b8',
          fontSize: '14px'
        }}>
          <strong style={{ color: '#e2e8f0' }}>Recommended Action:</strong> {contact.recommended_action}
        </div>
      )}
    </div>

    {/* Enrichment Status */}
    <div style={{
      backgroundColor: '#0f1629',
      border: '1px solid #1e293b',
      borderRadius: '8px',
      padding: '20px'
    }}>
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '16px' }}>
        <h3 style={{ margin: 0, color: '#e2e8f0', fontSize: '16px' }}>
          🤖 AI Intelligence Status
        </h3>
        <span style={{
          padding: '4px 12px',
          borderRadius: '12px',
          fontSize: '12px',
          fontWeight: '500',
          backgroundColor: isEnriched ? 'rgba(16, 185, 129, 0.2)' : 'rgba(245, 158, 11, 0.2)',
          color: isEnriched ? '#10b981' : '#f59e0b'
        }}>
          {isEnriched ? '✓ Enriched' : '⏳ Not Enriched'}
        </span>
      </div>

      {isEnriched ? (
        <div style={{ color: '#94a3b8', fontSize: '14px', lineHeight: '1.6' }}>
          <p style={{ margin: '0 0 8px' }}>Enhanced enrichment with strategic insights</p>
          <div style={{ display: 'flex', gap: '24px', marginTop: '12px' }}>
            <div>
              <strong style={{ color: '#6366f1' }}>Last Enriched:</strong>{' '}
              {formatDate(enrichmentDate)}
            </div>
            <div>
              <strong style={{ color: '#6366f1' }}>Times Enriched:</strong>{' '}
              {enrichmentCount} {enrichmentCount === 1 ? 'time' : 'times'}
            </div>
          </div>
          <button
            onClick={handleEnrich}
            style={{
              marginTop: '16px',
              background: 'rgba(99, 102, 241, 0.2)',
              color: '#6366f1',
              border: '1px solid rgba(99, 102, 241, 0.3)',
              padding: '8px 16px',
              borderRadius: '6px',
              fontSize: '13px',
              fontWeight: '500',
              cursor: 'pointer'
            }}
          >
            🔄 Re-Enrich Contact
          </button>
        </div>
      ) : (
        <>
          <p style={{ margin: '0 0 16px', color: '#94a3b8', fontSize: '14px' }}>
            Enrich this contact to generate AI-powered insights about pain points, SBA interests, and conversation starters.
          </p>
          <button
            onClick={handleEnrich}
            style={{
              background: 'linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)',
              color: 'white',
              border: 'none',
              padding: '10px 20px',
              borderRadius: '6px',
              fontSize: '14px',
              fontWeight: '500',
              cursor: 'pointer'
            }}
          >
            ✨ Enrich Contact
          </button>
        </>
      )}
    </div>
  </div>
);

