        {/* Contact Info Summary Card */}
        <ValueCard
          icon="👤"
          title={contact.name}
          subtitle={`${contact.title} at ${contact.company}`}
          items={[
            contact.email ? `📧 ${contact.email}` : '',
            contact.phone ? `📞 ${contact.phone}` : '',
            contact.linkedin_url ? `🔗 LinkedIn Profile` : ''
          ].filter(Boolean)}
          color="#3b82f6"
          compact
        />

        {parsedSections.overview && (
          <ValueCard
            icon="📊"
            title="Overview"
            subtitle="Current role and focus"
            items={[parsedSections.overview]}
            color="#3b82f6"
