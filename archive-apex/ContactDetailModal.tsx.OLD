);

// GENERATED CONTENT TAB
const GeneratedContentTab: React.FC<any> = ({
  isEnriched,
  isGenerating,
  generationError,
  generatedContent,
  handleGenerateAllContent,
  copyText,
  copiedField
}) => (
  <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
    {/* Generation Controls */}
    <div style={{
      backgroundColor: '#0f1629',
      border: '1px solid #1e293b',
      borderRadius: '8px',
      padding: '20px'
    }}>
      <h3 style={{ margin: '0 0 16px', color: '#e2e8f0', fontSize: '16px' }}>
        ✨ Content Generation
      </h3>
      <p style={{ margin: '0 0 16px', color: '#94a3b8', fontSize: '14px' }}>
        {isEnriched
          ? 'Generate personalized outreach content based on AI intelligence' 
          : '⚠️ Enrich this contact first for better content quality'}
      </p>

      <button
        onClick={handleGenerateAllContent}
        disabled={isGenerating || !isEnriched}
        style={{
          background: (isGenerating || !isEnriched)
            ? '#64748b' 
            : 'linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)',
          color: 'white',
          border: 'none',
          padding: '12px 24px',
          borderRadius: '6px',
          fontSize: '14px',
          fontWeight: '500',
          cursor: (isGenerating || !isEnriched) ? 'not-allowed' : 'pointer',
          opacity: (isGenerating || !isEnriched) ? 0.6 : 1
        }}
      >
        {isGenerating ? '⏳ Generating...' : '✨ Generate All Content (3 Emails + 3 Calls + LinkedIn)'}
      </button>

      {generationError && (
        <div style={{
          marginTop: '12px',
          padding: '12px',
          backgroundColor: 'rgba(239, 68, 68, 0.2)',
          border: '1px solid rgba(239, 68, 68, 0.3)',
          borderRadius: '6px',
          color: '#ef4444',
          fontSize: '14px'
        }}>
          ❌ {generationError}
        </div>
      )}
    </div>

    {/* Email Sequences */}
    <div style={{
      backgroundColor: '#0f1629',
      border: '1px solid #1e293b',
      borderRadius: '8px',
      padding: '20px'
    }}>
      <h3 style={{ 
        margin: '0 0 20px', 
        color: '#e2e8f0', 
        fontSize: '18px',
        fontWeight: '600'
      }}>
        📧 Email Sequence (3 Emails)
      </h3>

      {generatedContent.email.map((email: any, index: number) => (
        <ContentCard
          key={`email-${index}`}
          title={`Email ${index + 1} - ${['Introduction (Day 1)', 'Value Add (Day 4)', 'Breakup (Day 7)'][index]}`}
          content={email}
          type="email"
          index={index}
          onCopy={copyText}
          copiedField={copiedField}
        />
      ))}
    </div>

    {/* Call Scripts */}
    <div style={{
      backgroundColor: '#0f1629',
      border: '1px solid #1e293b',
      borderRadius: '8px',
      padding: '20px'
    }}>
      <h3 style={{ 
        margin: '0 0 20px', 
        color: '#e2e8f0', 
        fontSize: '18px',
        fontWeight: '600'
      }}>
        📞 Call Scripts (3 Scripts)
      </h3>

      {generatedContent.call.map((script: string, index: number) => (
        <ContentCard
          key={`call-${index}`}
          title={`Script ${index + 1} - ${['Cold Call', 'Follow-up Call', 'Executive Briefing'][index]}`}
          content={script}
          type="call"
          index={index}
          onCopy={copyText}
          copiedField={copiedField}
        />
      ))}
    </div>

    {/* LinkedIn Messages */}
    <div style={{
      backgroundColor: '#0f1629',
      border: '1px solid #1e293b',
      borderRadius: '8px',
      padding: '20px'
    }}>
      <h3 style={{ 
        margin: '0 0 20px', 
        color: '#e2e8f0', 
        fontSize: '18px',
        fontWeight: '600'
      }}>
        💼 LinkedIn Messages (2 Messages)
      </h3>

      {generatedContent.linkedin.map((message: string, index: number) => (
        <ContentCard
          key={`linkedin-${index}`}
          title={index === 0 ? 'Connection Request' : 'Follow-up Message'}
          content={message}
          type="linkedin"
          index={index}
          onCopy={copyText}
          copiedField={copiedField}
        />
      ))}
    </div>
  </div>
);

// REUSABLE VALUE CARD COMPONENT (Like SBA Financing)
const ValueCard: React.FC<{
  icon: string;
  title: string;
  subtitle: string;
  items: string[];
  color: string;
  compact?: boolean;
}> = ({ icon, title, subtitle, items, color, compact }) => {
  return (
    <div style={{
      backgroundColor: '#0f1629',
      border: `2px solid ${color}33`,
      borderRadius: '12px',
      padding: compact ? '20px' : '28px',
      boxShadow: `0 4px 20px ${color}15`
    }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: '12px', marginBottom: compact ? '12px' : '16px' }}>
        <div style={{ 
          fontSize: compact ? '24px' : '32px',
          width: compact ? '40px' : '50px',
          height: compact ? '40px' : '50px',
          borderRadius: '10px',
          background: `${color}22`,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center'
        }}>
          {icon}
        </div>
        <div>
          <h3 style={{ 
            margin: 0, 
            color: color, 
            fontSize: compact ? '16px' : '18px',
            fontWeight: '700',
            letterSpacing: '0.3px'
          }}>
            {title}
          </h3>
          <p style={{ margin: '4px 0 0', color: '#94a3b8', fontSize: compact ? '12px' : '13px' }}>
            {subtitle}
          </p>
        </div>
      </div>

      <div style={{
        marginTop: compact ? '12px' : '20px',
        display: 'flex',
        flexDirection: 'column',
        gap: compact ? '8px' : '16px'
      }}>
        {items.map((item, idx) => (
          <div 
            key={idx} 
            style={{
              padding: compact ? '12px' : '16px',
              backgroundColor: '#1e293b',
              borderRadius: '8px',
              borderLeft: `4px solid ${color}`,
              color: '#e2e8f0',
              fontSize: '14px',
              lineHeight: '1.7',
              fontWeight: '400'
            }}
          >
            {item}
          </div>
        ))}
      </div>
    </div>
  );
};

// Helper Components
const InfoField: React.FC<{ label: string; value: string; copyable?: boolean }> = ({ label, value, copyable }) => (
  <div>
    <div style={{ 
      fontSize: '11px', 
      color: '#64748b', 
      marginBottom: '4px',
      textTransform: 'uppercase',
      letterSpacing: '0.5px',
      fontWeight: '500'
    }}>
      {label}
    </div>
    <div style={{ 
      color: '#e2e8f0', 
      fontSize: '14px',
      display: 'flex',
      alignItems: 'center',
      gap: '8px'
    }}>
      {value}
      {copyable && value !== 'N/A' && (
        <button
          onClick={() => navigator.clipboard.writeText(value)}
          style={{
            background: 'none',
            border: 'none',
            color: '#64748b',
            cursor: 'pointer',
            padding: '2px',
            fontSize: '14px'
          }}
          title="Copy to clipboard"
        >
          📋
        </button>
      )}
    </div>
  </div>
);

const ScoreCard: React.FC<{ label: string; value?: number; tier?: string; color: string }> = ({ 
  label, 
  value, 
  tier, 
  color 
}) => (
  <div style={{
    padding: '16px',
    backgroundColor: '#1e293b',
    borderRadius: '6px',
    textAlign: 'center'
  }}>
    <div style={{ fontSize: '11px', color: '#64748b', marginBottom: '8px', textTransform: 'uppercase' }}>
      {label}
    </div>
    <div style={{ fontSize: '32px', fontWeight: 'bold', color, marginBottom: '4px' }}>
      {value !== null && value !== undefined ? Math.round(value) : '—'}
    </div>
    {tier && (
      <div style={{
        fontSize: '12px',
        padding: '4px 8px',
        borderRadius: '12px',
        backgroundColor: `${color}33`,
        color: color,
        display: 'inline-block',
        fontWeight: '500'
      }}>
        {tier}
      </div>
    )}
  </div>
);

const EmptyState: React.FC<{ icon: string; title: string }> = ({ icon, title }) => (
  <div style={{
    backgroundColor: '#0f1629',
    border: '1px solid #1e293b',
    borderRadius: '8px',
    padding: '40px',
    textAlign: 'center',
    color: '#94a3b8'
  }}>
    <div style={{ fontSize: '48px', marginBottom: '16px' }}>{icon}</div>
    <h3 style={{ margin: '0 0 8px', color: '#e2e8f0' }}>{title}</h3>
    <p style={{ margin: 0 }}>Enrich this contact first to view insights</p>
  </div>
);

const ContentCard: React.FC<{
  title: string;
  content: any;
  type: 'email' | 'call' | 'linkedin';
  index: number;
  onCopy: (text: string, field: string) => void;
  copiedField: string;
}> = ({ title, content, type, index, onCopy, copiedField }) => {
  const hasContent = type === 'email' 
    ? (content.subject || content.body)
    : Boolean(content);

  const fieldId = `${type}-${index}`;

  return (
    <div style={{
      marginBottom: '24px',
      padding: '20px',
      backgroundColor: '#1e293b',
      borderRadius: '8px',
      border: '1px solid #334155'
    }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '16px' }}>
        <h4 style={{ margin: 0, color: '#e2e8f0', fontSize: '15px', fontWeight: '600' }}>
          {title}
        </h4>
      </div>

      {hasContent ? (
        type === 'email' ? (
          <>
            <div style={{ marginBottom: '16px' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '8px' }}>
                <strong style={{ color: '#cbd5e1', fontSize: '13px' }}>Subject:</strong>
                <button
                  onClick={() => onCopy(content.subject, `${fieldId}-subject`)}
                  style={{
                    background: 'none',
                    border: 'none',
                    color: copiedField === `${fieldId}-subject` ? '#10b981' : '#64748b',
                    cursor: 'pointer',
                    fontSize: '16px',
                    padding: '4px 8px'
                  }}
                  title="Copy to clipboard"
                >
                  {copiedField === `${fieldId}-subject` ? '✓ Copied' : '📋 Copy'}
                </button>
              </div>
              <div style={{ 
                color: '#e2e8f0', 
                fontSize: '14px',
                padding: '12px',
                backgroundColor: '#0f1629',
                borderRadius: '6px',
                fontWeight: '500'
              }}>
                {content.subject}
              </div>
            </div>
            <div>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '8px' }}>
                <strong style={{ color: '#cbd5e1', fontSize: '13px' }}>Body:</strong>
                <button
                  onClick={() => onCopy(content.body, `${fieldId}-body`)}
                  style={{
                    background: 'none',
                    border: 'none',
                    color: copiedField === `${fieldId}-body` ? '#10b981' : '#64748b',
                    cursor: 'pointer',
                    fontSize: '16px',
                    padding: '4px 8px'
                  }}
                  title="Copy to clipboard"
                >
                  {copiedField === `${fieldId}-body` ? '✓ Copied' : '📋 Copy'}
                </button>
              </div>
              <div style={{ 
                color: '#94a3b8', 
                fontSize: '14px',
                padding: '16px',
                backgroundColor: '#0f1629',
                borderRadius: '6px',
                lineHeight: '1.7',
                whiteSpace: 'pre-wrap'
              }}>
                {content.body}
              </div>
            </div>
          </>
        ) : (
          <div>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '12px' }}>
              <strong style={{ color: '#cbd5e1', fontSize: '13px' }}>
                {type === 'call' ? 'Script:' : 'Message:'}
              </strong>
              <button
                onClick={() => onCopy(content, fieldId)}
                style={{
                  background: 'none',
                  border: 'none',
                  color: copiedField === fieldId ? '#10b981' : '#64748b',
                  cursor: 'pointer',
                  fontSize: '16px',
                  padding: '4px 8px'
                }}
                title="Copy to clipboard"
              >
                {copiedField === fieldId ? '✓ Copied' : '📋 Copy'}
              </button>
            </div>
            <div style={{ 
              color: '#94a3b8', 
              fontSize: '14px',
              padding: '16px',
              backgroundColor: '#0f1629',
              borderRadius: '6px',
              lineHeight: '1.7',
              whiteSpace: 'pre-wrap'
            }}>
              {content}
            </div>
          </div>
        )
      ) : (
        <div style={{
          color: '#64748b',
          fontSize: '14px',
          fontStyle: 'italic',
          textAlign: 'center',
          padding: '32px',
          backgroundColor: '#0f1629',
          borderRadius: '6px'
        }}>
          Content will appear here after generation
        </div>
      )}
    </div>
  );
};

export default ContactDetailModal;
