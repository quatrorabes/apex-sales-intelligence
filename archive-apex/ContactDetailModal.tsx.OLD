        {parsedSections.background && parsedSections.background.length > 0 && (
          <ValueCard
            icon="📚"
            title="Background"
            subtitle="Work history and achievements"
            items={parsedSections.background}
            color="#3b82f6"
          />
        )}

        {parsedSections.education && parsedSections.education.length > 0 && (
          <ValueCard
            icon="🎓"
            title="Education"
            subtitle="Degrees and institutions"
            items={parsedSections.education}
            color="#3b82f6"
          />
        )}

        {parsedSections.recent_mentions && parsedSections.recent_mentions.length > 0 && (
          <ValueCard
            icon="📰"
            title="Recent Mentions & Online Presence"
            subtitle="News, posts, and media coverage"
            items={parsedSections.recent_mentions}
            color="#3b82f6"
          />
        )}

        {parsedSections.professional_network && parsedSections.professional_network.length > 0 && (
          <ValueCard
            icon="🤝"
            title="Professional Network"
            subtitle="Industry associations and connections"
            items={parsedSections.professional_network}
            color="#3b82f6"
          />
        )}
      </>
