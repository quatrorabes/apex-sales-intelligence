/* ==================== O3PRO CONTACT DETAIL MODAL ==================== */

/* Modal Overlay & Container */
.o3-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(4px);
  z-index: var(--z-modal-backdrop);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-6);
  animation: fadeIn 250ms var(--transition-normal);
}

.o3-modal-container {
  width: 100%;
  max-width: 1200px;
  max-height: 90vh;
  background: var(--slate-800);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xl);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: slideUp 300ms var(--transition-normal);
}

/* ==================== STICKY HEADER ==================== */

.o3-modal-header {
  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
  background: var(--gradient-primary);
  padding: var(--space-6);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

/* Close Button */
.o3-close-btn {
  position: absolute;
  top: var(--space-4);
  right: var(--space-4);
  width: 32px;
  height: 32px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all var(--transition-fast);
  z-index: 10;
}

.o3-close-btn:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(1.1);
}

/* Contact Hero */
.o3-contact-hero {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.o3-avatar {
  width: 64px;
  height: 64px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.15);
  border: 2px solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: white;
  text-transform: uppercase;
  flex-shrink: 0;
}

.o3-hero-info {
  flex: 1;
  min-width: 0;
}

.o3-hero-name {
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: white;
  line-height: var(--leading-tight);
  margin: 0 0 var(--space-1) 0;
}

.o3-hero-title {
  font-size: var(--text-base);
  color: rgba(255, 255, 255, 0.9);
  line-height: var(--leading-normal);
  margin: 0;
}

/* Score Pills */
.o3-score-pills {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-6);
  flex-wrap: wrap;
}

.o3-score-pill {
  flex: 1;
  min-width: 100px;
  padding: var(--space-4);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
  transition: all var(--transition-fast);
  position: relative;
  overflow: hidden;
}

.o3-score-pill::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--score-color, var(--neutral-gray));
  opacity: 0.8;
}

.o3-score-pill:hover {
  background: rgba(255, 255, 255, 0.15);
  transform: translateY(-2px);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
}

.o3-pill-value {
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: white;
  line-height: 1;
}

.o3-pill-label {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: rgba(255, 255, 255, 0.8);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* ==================== TAB NAVIGATION ==================== */

.o3-tab-nav {
  display: flex;
  gap: var(--space-2);
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.o3-tab-nav::-webkit-scrollbar {
  display: none;
}

.o3-tab {
  position: relative;
  padding: var(--space-3) var(--space-4);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: rgba(255, 255, 255, 0.7);
  background: transparent;
  border: none;
  cursor: pointer;
  transition: color var(--transition-fast);
  white-space: nowrap;
  flex-shrink: 0;
}

.o3-tab:hover {
  color: rgba(255, 255, 255, 0.95);
}

.o3-tab.active {
  color: white;
}

.o3-tab.active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: white;
  border-radius: 2px 2px 0 0;
  animation: slideInFromLeft 200ms var(--transition-normal);
}

/* ==================== CONTENT AREA ==================== */

.o3-modal-content {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-6);
  background: var(--slate-900);
}

/* Stats Grid */
.o3-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

/* ==================== CARDS ==================== */

.o3-card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-normal);
}

.o3-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
  border-color: var(--border-strong);
}

.o3-card-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin: 0 0 var(--space-4) 0;
}

.o3-card-title svg {
  color: var(--info-blue);
}

/* Info List */
.o3-info-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.o3-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--border-subtle);
}

.o3-info-row:last-child {
  border-bottom: none;
}

.o3-info-label {
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--text-secondary);
  min-width: 100px;
}

.o3-info-value {
  font-size: var(--text-sm);
  color: var(--text-primary);
  font-family: var(--font-mono);
  text-align: right;
  flex: 1;
}

.o3-info-value-group {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex: 1;
  justify-content: flex-end;
}

/* Copy Button */
.o3-copy-btn {
  width: 28px;
  height: 28px;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.o3-copy-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-primary);
  border-color: var(--border-strong);
}

.o3-copy-btn:active {
  transform: scale(0.95);
}

/* Status Badge */
.o3-status-badge {
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  background: rgba(var(--status-color, 107, 114, 128), 0.15);
  border: 1px solid rgba(var(--status-color, 107, 114, 128), 0.3);
  color: var(--status-color, var(--neutral-gray));
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Enrich Button */
.o3-enrich-btn {
  width: 100%;
  margin-top: var(--space-4);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-base);
  background: var(--gradient-primary);
  color: white;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.o3-enrich-btn:hover:not(:disabled) {
  background: var(--gradient-primary-hover);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.o3-enrich-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* ==================== TAB CONTENT ==================== */

.o3-tab-content {
  min-height: 400px;
}

.o3-tab-panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  animation: fadeIn 300ms var(--transition-normal);
}

.o3-content-card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
}

.o3-content-card h3 {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin: 0 0 var(--space-4) 0;
}

.o3-content-card p {
  font-size: var(--text-base);
  line-height: var(--leading-relaxed);
  color: var(--text-secondary);
  margin: 0;
}

.o3-highlight-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-color: rgba(102, 126, 234, 0.3);
}

.o3-highlight-card h3 svg {
  color: var(--info-blue);
}

/* List */
.o3-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.o3-list li {
  position: relative;
  padding-left: var(--space-6);
  font-size: var(--text-base);
  line-height: var(--leading-relaxed);
  color: var(--text-secondary);
}

.o3-list li::before {
  content: '→';
  position: absolute;
  left: 0;
  color: var(--info-blue);
  font-weight: var(--weight-bold);
}

/* MBTI Badge */
.o3-mbti-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-3) var(--space-6);
  border-radius: var(--radius-lg);
  background: var(--gradient-primary);
  color: white;
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  letter-spacing: 0.1em;
  margin-bottom: var(--space-4);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
}

/* ==================== EMPTY STATE ==================== */

.o3-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  padding: var(--space-12) var(--space-6);
  text-align: center;
}

.o3-empty-state svg {
  color: var(--text-tertiary);
  opacity: 0.5;
}

.o3-empty-state p {
  font-size: var(--text-base);
  color: var(--text-secondary);
  margin: 0;
}

.o3-btn-secondary {
  padding: var(--space-3) var(--space-6);
  border-radius: var(--radius-base);
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.o3-btn-secondary:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: var(--border-strong);
  transform: translateY(-1px);
}

/* ==================== ANIMATIONS ==================== */

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInFromLeft {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(0);
  }
}

/* ==================== RESPONSIVE ==================== */

@media (max-width: 768px) {
  .o3-modal-overlay {
    padding: 0;
  }

  .o3-modal-container {
    max-height: 100vh;
    border-radius: 0;
  }

  .o3-modal-header {
    padding: var(--space-4);
  }

  .o3-hero-name {
    font-size: var(--text-xl);
  }

  .o3-score-pills {
    flex-direction: column;
  }

  .o3-score-pill {
    flex: none;
  }

  .o3-stats-grid {
    grid-template-columns: 1fr;
  }

  .o3-info-row {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .o3-info-value-group {
    width: 100%;
    justify-content: space-between;
  }
}

@media (max-width: 480px) {
  .o3-tab-nav {
    gap: 0;
  }

  .o3-tab {
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-3);
  }
}
