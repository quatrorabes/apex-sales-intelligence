ext-white\">{contact.name}<\/p>\n                <\/div>\n                <div>\n                  <p className=\"text-sm text-slate-400 mb-1\">Email<\/p>\n                  <p className=\"text-white\">{contact.email || \"N\/A\"}<\/p>\n                <\/div>\n                <div>\n                  <p className=\"text-sm text-slate-400 mb-1\">Title<\/p>\n                  <p className=\"text-white\">{contact.title || \"N\/A\"}<\/p>\n                <\/div>\n                <div>\n                  <p className=\"text-sm text-slate-400 mb-1\">Phone<\/p>\n                  <p className=\"text-white\">{contact.phone || \"N\/A\"}<\/p>\n                <\/div>\n                {contact.linkedin_url && (\n                  <div className=\"col-span-2\">\n                    <p className=\"text-sm text-slate-400 mb-1\">LinkedIn<\/p>\n                    <a\n                      href={contact.linkedin_url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"text-cyan-400 hover:underline flex items-center gap-1\"\n                    >\n                      View Profile\n                      <ExternalLink className=\"w-3 h-3\" \/>\n                    <\/a>\n                  <\/div>\n                )}\n              <\/div>\n            <\/div>\n\n            {\/* Company Intel *\/}\n            <div className=\"bg-slate-900\/50 rounded-xl p-6 border border-slate-700\">\n              <h3 className=\"flex items-center gap-2 text-lg font-medium text-cyan-400 mb-4\">\n                <Building2 className=\"w-5 h-5\" \/>\n                Company Intel\n              <\/h3>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <p className=\"text-sm text-slate-400 mb-1\">Company<\/p>\n                  <p className=\"text-white\">{contact.company || \"N\/A\"}<\/p>\n                <\/div>\n                <div>\n                  <p className=\"text-sm 