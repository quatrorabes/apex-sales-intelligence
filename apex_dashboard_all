    "content" : "import React, { useEffect, useMemo, useState, useRef } from \"react\";\nimport {\n  Search,\n  Users,\n  TrendingUp,\n  Brain,\n  Sparkles,\n  Zap,\n  RefreshCw,\n  Clock,\n  List,\n  Grid,\n  ArrowUpDown,\n  CheckCircle2,\n  Eye,\n  Mail,\n  Phone,\n  MessageSquare,\n  Building,\n  Briefcase,\n  X,\n  Upload,\n  FileText,\n  Database,\n  Download\n} from \"lucide-react\";\nimport ContactEnrichmentView from \".\/components\/ContactEnrichmentView\";\nimport ContactDetailModal from \".\/components\/ContactDetailModal\";\nimport CadenceDashboard from \".\/components\/CadenceDashboard\";\nimport RawDataViewer from \".\/components\/RawDataViewer\";\nimport { ApexIntelligenceDashboard } from \".\/components\/ApexIntelligence\";\nimport BatchProgress from \".\/components\/BatchProgress\";\n\n\/\/ TYPE DEFINITIONS\nexport interface Contact {\n  id: number;\n  hubspot_id?: string;\n  name: string;\n  firstname?: string;\n  lastname?: string;\n  title: string | null;\n  company: string | null;\n  email: string | null;\n  phone?: string | null;\n  linkedin_url?: string | null;\n  enrichment_status?: \"pending\" | \"processing\" | \"complete\" | \"failed\" | null;\n  enrichment_data?: any;\n  opportunity_score?: number;\n  dashboard?: any;\n  generated_scripts?: any;\n  pain_points?: string[];\n  talking_points?: string[];\n  trigger_events?: string[];\n  mdcp_score?: number;\n  rss_score?: number;\n  priority_score?: number;\n}\n\ninterface Analytics {\n  total_contacts: number;\n  enriched_contacts: number;\n  pending_enrichment: number;\n  avg_opportunity_score: number;\n  contacts_last_30_days: number;\n  high_priority_contacts: number;\n}\n\nfunction App() {\n  const [contacts, setContacts] = useState<Contact[]>([]);\n  const [analytics, setAnalytics] = useState<Analytics>({\n    total_contacts: 0,\n    enriched_contacts: 0,\n    pending_enrichment: 0,\n    avg_opportunity_score: 0,\n    contacts_last_30_days: 0,\n    high_priority_contacts: 0,\n  });\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [filterStatus, setFilterStatus] = useState(\"all\");\n  const [selectedContact, setSelectedContact] = useState<Contact | null>(null);\n  const [showEnrichmentView, setShowEnrichmentView] = useState(false);\n  const [selectedContacts, setSelectedContacts] = useState<Set<number>>(new Set());\n  const [isLoading, setIsLoading] = useState(false);\n  const [activeTab, setActiveTab] = useState(\"contacts\");\n  const [viewMode, setViewMode] = useState<\"list\" | \"card\">(\"list\");\n  const [showBatchProgress, setShowBatchProgress] = useState(false);\n  const [sortConfig, setSortConfig] = useState<{\n    key: keyof Contact;\n    direction: \"asc\" | \"desc\";\n  }>({ key: \"name\", direction: \"asc\" });\n  const [showRawData, setShowRawData] = useState(false);\n  const [selectedRawData, setSelectedRawData] = useState<any>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const API_BASE = \"http:\/\/localhost:8000\";\n\n  \/\/ Fetch contacts\n  const fetchContacts = async () => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/contacts\");\n      if (response.ok) {\n        const data = await response.json();\n        const contactsList = Array.isArray(data) ? data : (data.contacts || []);\n        setContacts(contactsList);\n      }\n    } catch (error) {\n      console.error(\"Error fetching contacts:\", error);\n    }\n  };\n\n  \/\/ Fetch analytics\n  const fetchAnalytics = async () => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/analytics\/dashboard\");\n      if (response.ok) {\n        const data = await response.json();\n        setAnalytics(data);\n      }\n    } catch (error) {\n      console.error(\"Error fetching analytics:\", error);\n    }\n  };\n\n  \/\/ Fetch dashboard data\n  const fetchDashboardData = async (contactId: number) => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/dashboard\/\" + contactId);\n      if (response.ok) {\n        const data = await response.json();\n        return data;\n      }\n    } catch (error) {\n      console.error(\"Error fetching dashboard:\", error);\n    }\n    return null;\n  };\n\n  \/\/ Handle view intelligence\n  const handleViewIntelligence = async (contact: Contact) => {\n    try {\n      const dashboardData = await fetchDashboardData(contact.id);\n      if (dashboardData) {\n        const enrichedContact = {\n          ...contact,\n          dashboard: dashboardData,\n          generated_scripts: dashboardData.generated_scripts || {},\n          pain_points: dashboardData.pain_points || [],\n          talking_points: dashboardData.talking_points || [],\n          trigger_events: dashboardData.trigger_events || []\n        };\n        setSelectedContact(enrichedContact);\n      } else {\n        setSelectedContact(contact);\n      }\n      setShowEnrichmentView(true);\n    } catch (error) {\n      console.error(\"Error:\", error);\n      setSelectedContact(contact);\n      setShowEnrichmentView(true);\n    }\n  };\n\n  \/\/ View raw data\n  const handleViewRawData = async (contact: Contact) => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/dashboard\/\" + contact.id);\n      if (response.ok) {\n        const data = await response.json();\n        setSelectedRawData(data);\n        setShowRawData(true);\n      }\n    } catch (error) {\n      console.error(\"Error viewing raw data:\", error);\n    }\n  };\n\n  \/\/ Trigger enrichment\n  const triggerEnrichment = async (contactId: number) => {\n    try {\n      setIsLoading(true);\n      const response = await fetch(API_BASE + \"\/api\/contacts\/\" + contactId + \"\/deep-enrich\", { \n        method: \"POST\" \n      });\n      if (response.ok) {\n        console.log(\"Enrichment started for contact\", contactId);\n        setTimeout(() => {\n          fetchContacts();\n          fetchAnalytics();\n        }, 3000);\n      }\n    } catch (error) {\n      console.error(\"Error:\", error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  \/\/ Generate scripts\n  const generateScripts = async (contactId: number) => {\n    try {\n      setIsLoading(true);\n      const response = await fetch(API_BASE + \"\/api\/contacts\/\" + contactId + \"\/generate-scripts\", {\n        method: \"POST\"\n      });\n      if (response.ok) {\n        const scripts = await response.json();\n        alert(\"Scripts generated successfully! View in Intelligence Report.\");\n        fetchContacts();\n      }\n    } catch (error) {\n      console.error(\"Error generating scripts:\", error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  \/\/ Import contacts from CSV\n  const handleImportContacts = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    const formData = new FormData();\n    formData.append(\"file\", file);\n\n    try {\n      setIsLoading(true);\n      const response = await fetch(API_BASE + \"\/api\/import\/contacts\", {\n        method: \"POST\",\n        body: formData\n      });\n\n      if (response.ok) {\n        const result = await response.json();\n        alert(\"Imported \" + result.count + \" contacts successfully!\");\n        fetchContacts();\n        fetchAnalytics();\n      }\n    } catch (error) {\n      console.error(\"Error importing contacts:\", error);\n      alert(\"Failed to import contacts\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  \/\/ Export contacts\n  const handleExportContacts = async () => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/export\/contacts\");\n      if (response.ok) {\n        const blob = await response.blob();\n        const url = window.URL.createObjectURL(blob);\n        const a = document.createElement(\"a\");\n        a.href = url;\n        a.download = \"contacts_export.csv\";\n        a.click();\n      }\n    } catch (error) {\n      console.error(\"Error exporting contacts:\", error);\n    }\n  };\n\n  \/\/ Batch enrichment\n  const handleBatchEnrich = async () => {\n    if (selectedContacts.size === 0) {\n      alert(\"Please select contacts to enrich\");\n      return;\n    }\n\n    setShowBatchProgress(true);\n    const contactIds = Array.from(selectedContacts);\n\n    for (const id of contactIds) {\n      await triggerEnrichment(id);\n      await new Promise(resolve => setTimeout(resolve, 1000));\n    }\n\n    setShowBatchProgress(false);\n    setSelectedContacts(new Set());\n    fetchContacts();\n  };\n\n  \/\/ Handle sort\n  const handleSort = (key: keyof Contact) => {\n    setSortConfig({\n      key,\n      direction: sortConfig.key === key && sortConfig.direction === \"asc\" ? \"desc\" : \"asc\",\n    });\n  };\n\n  \/\/ Toggle selection\n  const toggleContactSelection = (id: number) => {\n    const newSelected = new Set(selectedContacts);\n    if (newSelected.has(id)) {\n      newSelected.delete(id);\n    } else {\n      newSelected.add(id);\n    }\n    setSelectedContacts(newSelected);\n  };\n\n  \/\/ Filtered contacts\n  const filteredContacts = useMemo(() => {\n    let filtered = contacts;\n\n    if (searchTerm) {\n      filtered = filtered.filter(c =>\n        c.name?.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        c.company?.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        c.email?.toLowerCase().includes(searchTerm.toLowerCase())\n      );\n    }\n\n    if (filterStatus !== \"all\") {\n      filtered = filtered.filter(c => c.enrichment_status === filterStatus);\n    }\n\n    filtered.sort((a, b) => {\n      const aVal = a[sortConfig.key];\n      const bVal = b[sortConfig.key];\n\n      if (aVal === null || aVal === undefined) return 1;\n      if (bVal === null || bVal === undefined) return -1;\n\n      if (typeof aVal === \"string\" && typeof bVal === \"string\") {\n        return sortConfig.direction === \"asc\"\n          ? aVal.localeCompare(bVal)\n          : bVal.localeCompare(aVal);\n      }\n\n      if (typeof aVal === \"number\" && typeof bVal === \"number\") {\n        return sortConfig.direction === \"asc\" ? aVal - bVal : bVal - aVal;\n      }\n\n      return 0;\n    });\n\n    return filtered;\n  }, [contacts, searchTerm, filterStatus, sortConfig]);\n\n  \/\/ Initial load\n  useEffect(() => {\n    fetchContacts();\n    fetchAnalytics();\n    const interval = setInterval(() => {\n      fetchContacts();\n      fetchAnalytics();\n    }, 30000);\n    return () => clearInterval(interval);\n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900\">\n      {\/* Hidden file input for import *\/}\n      <input\n        ref={fileInputRef}\n        type=\"file\"\n        accept=\".csv\"\n        onChange={handleImportContacts}\n        style={{ display: \"none\" }}\n      \/>\n\n      {\/* Header *\/}\n      <header className=\"bg-slate-800\/50 border-b border-slate-700 backdrop-blur-sm sticky top-0 z-40\">\n        <div className=\"max-w-7xl mx-auto px-6 py-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-lg flex items-center justify-center\">\n                <Brain className=\"w-6 h-6 text-white\" \/>\n              <\/div>\n              <div>\n                <h1 className=\"text-2xl font-bold text-white\">\n                  APEX Sales Intelligence\n                <\/h1>\n                <p className=\"text-sm text-slate-400\">\n                  AI-Powered Contact Enrichment & Script Generation\n                <\/p>\n              <\/div>\n            <\/div>\n            <div className=\"flex items-center gap-4\">\n              <button\n                onClick={() => fileInputRef.current?.click()}\n                className=\"px-4 py-2 bg-slate-700 text-white rounded-lg hover:bg-slate-600 flex items-center gap-2\"\n                title=\"Import Contacts\"\n              >\n                <Upload className=\"w-4 h-4\" \/>\n                Import\n              <\/button>\n              <button\n                onClick={handleExportContacts}\n                className=\"px-4 py-2 bg-slate-700 text-white rounded-lg hover:bg-slate-600 flex items-center gap-2\"\n                title=\"Export Contacts\"\n              >\n                <Download className=\"w-4 h-4\" \/>\n                Export\n              <\/button>\n              <button\n                onClick={() => {\n                  fetchContacts();\n                  fetchAnalytics();\n                }}\n                className=\"p-2 text-slate-400 hover:text-white hover:bg-slate-700 rounded-lg\"\n              >\n                <RefreshCw className={isLoading ? \"w-5 h-5 animate-spin\" : \"w-5 h-5\"} \/>\n              <\/button>\n            <\/div>\n          <\/div>\n        <\/div>\n      <\/header>\n\n      {\/* Main Content *\/}\n      <main className=\"max-w-7xl mx-auto px-6 py-8\">\n        {\/* Analytics Cards *\/}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8\">\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Users className=\"w-5 h-5 text-cyan-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.total_contacts}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Total Contacts<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <CheckCircle2 className=\"w-5 h-5 text-green-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.enriched_contacts}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Enriched<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Clock className=\"w-5 h-5 text-yellow-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.pending_enrichment}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Pending<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <TrendingUp className=\"w-5 h-5 text-purple-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {Math.round(analytics.avg_opportunity_score)}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Avg Score<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Sparkles className=\"w-5 h-5 text-orange-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.contacts_last_30_days}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Last 30 Days<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Zap className=\"w-5 h-5 text-red-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.high_priority_contacts}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">High Priority<\/div>\n          <\/div>\n        <\/div>\n\n        {\/* Tabs *\/}\n        <div className=\"flex gap-2 mb-6 border-b border-slate-700\">\n          <button\n            onClick={() => setActiveTab(\"contacts\")}\n            className={activeTab === \"contacts\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <Users className=\"w-4 h-4 inline mr-2\" \/>\n            Contacts\n          <\/button>\n          <button\n            onClick={() => setActiveTab(\"intelligence\")}\n            className={activeTab === \"intelligence\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <Brain className=\"w-4 h-4 inline mr-2\" \/>\n            APEX Intelligence\n          <\/button>\n          <button\n            onClick={() => setActiveTab(\"cadence\")}\n            className={activeTab === \"cadence\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <MessageSquare className=\"w-4 h-4 inline mr-2\" \/>\n            Cadence\n          <\/button>\n          <button\n            onClick={() => setActiveTab(\"rawdata\")}\n            className={activeTab === \"rawdata\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <Database className=\"w-4 h-4 inline mr-2\" \/>\n            Raw Data\n          <\/button>\n        <\/div>\n\n        {\/* Contacts Tab Content *\/}\n        {activeTab === \"contacts\" && (\n          <>\n            {\/* Toolbar *\/}\n            <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-4 border border-slate-700 mb-6\">\n              <div className=\"flex items-center justify-between gap-4\">\n                <div className=\"flex-1 flex items-center gap-4\">\n                  <div className=\"relative flex-1 max-w-md\">\n                    <Search className=\"absolute left-3 top-1\/2 transform -translate-y-1\/2 w-5 h-5 text-slate-400\" \/>\n                    <input\n                      type=\"text\"\n                      placeholder=\"Search contacts...\"\n                      value={searchTerm}\n                      onChange={(e) => setSearchTerm(e.target.value)}\n                      className=\"w-full pl-10 pr-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500\"\n                    \/>\n                  <\/div>\n\n                  <select\n                    value={filterStatus}\n                    onChange={(e) => setFilterStatus(e.target.value)}\n                    className=\"px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white focus:outline-none focus:border-cyan-500\"\n                  >\n                    <option value=\"all\">All Status<\/option>\n                    <option value=\"pending\">Pending<\/option>\n                    <option value=\"complete\">Complete<\/option>\n                  <\/select>\n\n                  <button\n                    onClick={() => setViewMode(viewMode === \"list\" ? \"card\" : \"list\")}\n                    className=\"px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white hover:bg-slate-800\"\n                  >\n                    {viewMode === \"list\" ? (\n                      <><Grid className=\"w-4 h-4 inline mr-2\" \/>Card View<\/>\n                    ) : (\n                      <><List className=\"w-4 h-4 inline mr-2\" \/>List View<\/>\n                    )}\n                  <\/button>\n                <\/div>\n\n                {selectedContacts.size > 0 && (\n                  <button\n                    onClick={handleBatchEnrich}\n                    className=\"px-6 py-2 bg-gradient-to-r from-cyan-600 to-blue-600 text-white rounded-lg font-medium\"\n                  >\n                    <Zap className=\"w-4 h-4 inline mr-2\" \/>\n                    Enrich ({selectedContacts.size})\n                  <\/button>\n                )}\n              <\/div>\n            <\/div>\n\n            {\/* List View *\/}\n            {viewMode === \"list\" && (\n              <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden\">\n                <table className=\"w-full\">\n                  <thead className=\"bg-slate-900\/50\">\n                    <tr>\n                      <th className=\"px-6 py-4 text-left\">\n                        <input\n                          type=\"checkbox\"\n                          onChange={(e) => {\n                            if (e.target.checked) {\n                              setSelectedContacts(new Set(contacts.map(c => c.id)));\n                            } else {\n                              setSelectedContacts(new Set());\n                            }\n                          }}\n                          className=\"rounded border-slate-600\"\n                        \/>\n                      <\/th>\n                      <th \n                        className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300 cursor-pointer\"\n                        onClick={() => handleSort(\"name\")}\n                      >\n                        Name\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Company\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Title\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Score\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Status\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Actions\n                      <\/th>\n                    <\/tr>\n                  <\/thead>\n                  <tbody className=\"divide-y divide-slate-700\">\n                    {filteredContacts.map(contact => (\n                      <tr key={contact.id} className=\"hover:bg-slate-700\/30\">\n                        <td className=\"px-6 py-4\">\n                          <input\n                            type=\"checkbox\"\n                            checked={selectedContacts.has(contact.id)}\n                            onChange={() => toggleContactSelection(contact.id)}\n                            className=\"rounded border-slate-600\"\n                          \/>\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          <div className=\"text-white font-medium\">{contact.name}<\/div>\n                          <div className=\"text-sm text-slate-400\">{contact.email}<\/div>\n                        <\/td>\n                        <td className=\"px-6 py-4 text-slate-300\">\n                          {contact.company || \"-\"}\n                        <\/td>\n                        <td className=\"px-6 py-4 text-slate-300\">\n                          {contact.title || \"-\"}\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          {contact.opportunity_score ? (\n                            <div className=\"flex items-center gap-2\">\n                              <div className=\"w-16 h-2 bg-slate-700 rounded-full overflow-hidden\">\n                                <div\n                                  className=\"h-full bg-gradient-to-r from-cyan-500 to-blue-600\"\n                                  style={{ width: contact.opportunity_score + \"%\" }}\n                                \/>\n                              <\/div>\n                              <span className=\"text-sm text-slate-300\">\n                                {contact.opportunity_score}\n                              <\/span>\n                            <\/div>\n                          ) : (\n                            <span className=\"text-slate-500\">-<\/span>\n                          )}\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          {contact.enrichment_status === \"complete\" ? (\n                            <span className=\"px-2 py-1 bg-green-500\/20 text-green-400 rounded text-xs font-medium\">\n                              Complete\n                            <\/span>\n                          ) : (\n                            <span className=\"px-2 py-1 bg-gray-500\/20 text-gray-400 rounded text-xs font-medium\">\n                              Pending\n                            <\/span>\n                          )}\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          <div className=\"flex items-center gap-2\">\n                            <button\n                              onClick={() => handleViewIntelligence(contact)}\n                              className=\"p-2 text-cyan-400 hover:bg-slate-700 rounded-lg\"\n                              title=\"View Intelligence\"\n                            >\n                              <Eye className=\"w-4 h-4\" \/>\n                            <\/button>\n                            {contact.enrichment_status !== \"complete\" && (\n                              <button\n                                onClick={() => triggerEnrichment(contact.id)}\n                                className=\"p-2 text-purple-400 hover:bg-slate-700 rounded-lg\"\n                                title=\"Enrich\"\n                              >\n                                <Zap className=\"w-4 h-4\" \/>\n                              <\/button>\n                            )}\n                            {contact.enrichment_status === \"complete\" && (\n                              <>\n                                <button\n                                  onClick={() => generateScripts(contact.id)}\n                                  className=\"p-2 text-green-400 hover:bg-slate-700 rounded-lg\"\n                                  title=\"Generate Scripts\"\n                                >\n                                  <Sparkles className=\"w-4 h-4\" \/>\n                                <\/button>\n                                <button\n                                  onClick={() => handleViewRawData(contact)}\n                                  className=\"p-2 text-blue-400 hover:bg-slate-700 rounded-lg\"\n                                  title=\"View Raw Data\"\n                                >\n                                  <Database className=\"w-4 h-4\" \/>\n                                <\/button>\n                              <\/>\n                            )}\n                          <\/div>\n                        <\/td>\n                      <\/tr>\n                    ))}\n                  <\/tbody>\n                <\/table>\n              <\/div>\n            )}\n\n            {\/* Card View *\/}\n            {viewMode === \"card\" && (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                {filteredContacts.map(contact => (\n                  <div\n                    key={contact.id}\n                    className=\"bg-slate-800\/50 backdrop-blur-sm border border-slate-700 rounded-xl p-6\"\n                  >\n                    <div className=\"flex items-start justify-between mb-4\">\n                      <div>\n                        <h3 className=\"text-lg font-semibold text-white\">\n                          {contact.name}\n                        <\/h3>\n                        <p className=\"text-sm text-cyan-400\">{contact.email}<\/p>\n                      <\/div>\n                      <input\n                        type=\"checkbox\"\n                        checked={selectedContacts.has(contact.id)}\n                        onChange={() => toggleContactSelection(contact.id)}\n                        className=\"rounded border-slate-600\"\n                      \/>\n                    <\/div>\n\n                    <div className=\"space-y-2 mb-4\">\n                      <div className=\"text-sm text-slate-300\">\n                        <Building className=\"w-4 h-4 inline mr-2 text-slate-400\" \/>\n                        {contact.company || \"No company\"}\n                      <\/div>\n                      {contact.title && (\n                        <div className=\"text-sm text-slate-300\">\n                          <Briefcase className=\"w-4 h-4 inline mr-2 text-slate-400\" \/>\n                          {contact.title}\n                        <\/div>\n                      )}\n                    <\/div>\n\n                    <div className=\"flex items-center justify-between\">\n                      <span className={\n                        contact.enrichment_status === \"complete\"\n                          ? \"px-2 py-1 bg-green-500\/20 text-green-400 rounded text-xs\"\n                          : \"px-2 py-1 bg-gray-500\/20 text-gray-400 rounded text-xs\"\n                      }>\n                        {contact.enrichment_status || \"Pending\"}\n                      <\/span>\n\n                      <div className=\"flex items-center gap-2\">\n                        <button\n                          onClick={() => handleViewIntelligence(contact)}\n                          className=\"p-2 text-cyan-400 hover:bg-slate-700 rounded-lg\"\n                        >\n                          <Eye className=\"w-4 h-4\" \/>\n                        <\/button>\n                        {contact.enrichment_status !== \"complete\" && (\n                          <button\n                            onClick={() => triggerEnrichment(contact.id)}\n                            className=\"p-2 text-purple-400 hover:bg-slate-700 rounded-lg\"\n                          >\n                            <Zap className=\"w-4 h-4\" \/>\n                          <\/button>\n                        )}\n                        {contact.enrichment_status === \"complete\" && (\n                          <button\n                            onClick={() => generateScripts(contact.id)}\n                            className=\"p-2 text-green-400 hover:bg-slate-700 rounded-lg\"\n                          >\n                            <Sparkles className=\"w-4 h-4\" \/>\n                          <\/button>\n                        )}\n                      <\/div>\n                    <\/div>\n                  <\/div>\n                ))}\n              <\/div>\n            )}\n          <\/>\n        )}\n\n        {\/* Intelligence Tab *\/}\n        {activeTab === \"intelligence\" && (\n          <ApexIntelligenceDashboard contacts={contacts} \/>\n        )}\n\n        {\/* Cadence Tab *\/}\n        {activeTab === \"cadence\" && (\n          <CadenceDashboard contacts={contacts} \/>\n        )}\n\n        {\/* Raw Data Tab *\/}\n        {activeTab === \"rawdata\" && (\n          <RawDataViewer contacts={contacts} \/>\n        )}\n      <\/main>\n\n      {\/* Modals *\/}\n      {showEnrichmentView && selectedContact && (\n        <ContactEnrichmentView\n          contact={selectedContact}\n          onClose={() => {\n            setShowEnrichmentView(false);\n            setSelectedContact(null);\n            fetchContacts();\n          }}\n        \/>\n      )}\n\n      {showBatchProgress && (\n        <BatchProgress\n          totalContacts={selectedContacts.size}\n          onClose={() => setShowBatchProgress(false)}\n        \/>\n      )}\n\n      {\/* Raw Data Modal *\/}\n      {showRawData && selectedRawData && (\n        <div className=\"fixed inset-0 bg-black\/50 backdrop-blur-sm flex items-center justify-center p-6 z-50\">\n          <div className=\"bg-slate-800 rounded-xl border border-slate-700 max-w-4xl w-full max-h-[80vh] overflow-hidden flex flex-col\">\n            <div className=\"p-6 border-b border-slate-700 flex items-center justify-between\">\n              <h2 className=\"text-xl font-semibold text-white\">Raw Data<\/h2>\n              <button\n                onClick={() => {\n                  setShowRawData(false);\n                  setSelectedRawData(null);\n                }}\n                className=\"text-slate-400 hover:text-white\"\n              >\n                <X className=\"w-6 h-6\" \/>\n              <\/button>\n            <\/div>\n            <div className=\"p-6 overflow-y-auto\">\n              <pre className=\"bg-slate-900 rounded-lg p-4 text-sm text-green-400 overflow-x-auto\">\n                {JSON.stringify(selectedRawData, null, 2)}\n              <\/pre>\n            <\/div>\n          <\/div>\n        <\/div>\n      )}\n    <\/div>\n  );\n}\n\nexport default App;\n\n\nimport React, { useEffect, useMemo, useState, useRef } from \"react\";\nimport {\n  Search,\n  Users,\n  TrendingUp,\n  Brain,\n  Sparkles,\n  Zap,\n  RefreshCw,\n  Clock,\n  List,\n  Grid,\n  ArrowUpDown,\n  CheckCircle2,\n  Eye,\n  Mail,\n  Phone,\n  MessageSquare,\n  Building,\n  Briefcase,\n  X,\n  Upload,\n  FileText,\n  Database,\n  Download\n} from \"lucide-react\";\nimport ContactEnrichmentView from \".\/components\/ContactEnrichmentView\";\nimport ContactDetailModal from \".\/components\/ContactDetailModal\";\nimport CadenceDashboard from \".\/components\/CadenceDashboard\";\nimport RawDataViewer from \".\/components\/RawDataViewer\";\nimport { ApexIntelligenceDashboard } from \".\/components\/ApexIntelligence\";\nimport BatchProgress from \".\/components\/BatchProgress\";\n\n\/\/ TYPE DEFINITIONS\nexport interface Contact {\n  id: number;\n  hubspot_id?: string;\n  name: string;\n  firstname?: string;\n  lastname?: string;\n  title: string | null;\n  company: string | null;\n  email: string | null;\n  phone?: string | null;\n  linkedin_url?: string | null;\n  enrichment_status?: \"pending\" | \"processing\" | \"complete\" | \"failed\" | null;\n  enrichment_data?: any;\n  opportunity_score?: number;\n  dashboard?: any;\n  generated_scripts?: any;\n  pain_points?: string[];\n  talking_points?: string[];\n  trigger_events?: string[];\n  mdcp_score?: number;\n  rss_score?: number;\n  priority_score?: number;\n}\n\ninterface Analytics {\n  total_contacts: number;\n  enriched_contacts: number;\n  pending_enrichment: number;\n  avg_opportunity_score: number;\n  contacts_last_30_days: number;\n  high_priority_contacts: number;\n}\n\nfunction App() {\n  const [contacts, setContacts] = useState<Contact[]>([]);\n  const [analytics, setAnalytics] = useState<Analytics>({\n    total_contacts: 0,\n    enriched_contacts: 0,\n    pending_enrichment: 0,\n    avg_opportunity_score: 0,\n    contacts_last_30_days: 0,\n    high_priority_contacts: 0,\n  });\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [filterStatus, setFilterStatus] = useState(\"all\");\n  const [selectedContact, setSelectedContact] = useState<Contact | null>(null);\n  const [showEnrichmentView, setShowEnrichmentView] = useState(false);\n  const [selectedContacts, setSelectedContacts] = useState<Set<number>>(new Set());\n  const [isLoading, setIsLoading] = useState(false);\n  const [activeTab, setActiveTab] = useState(\"contacts\");\n  const [viewMode, setViewMode] = useState<\"list\" | \"card\">(\"list\");\n  const [showBatchProgress, setShowBatchProgress] = useState(false);\n  const [sortConfig, setSortConfig] = useState<{\n    key: keyof Contact;\n    direction: \"asc\" | \"desc\";\n  }>({ key: \"name\", direction: \"asc\" });\n  const [showRawData, setShowRawData] = useState(false);\n  const [selectedRawData, setSelectedRawData] = useState<any>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const API_BASE = \"http:\/\/localhost:8000\";\n\n  \/\/ Fetch contacts\n  const fetchContacts = async () => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/contacts\");\n      if (response.ok) {\n        const data = await response.json();\n        const contactsList = Array.isArray(data) ? data : (data.contacts || []);\n        setContacts(contactsList);\n      }\n    } catch (error) {\n      console.error(\"Error fetching contacts:\", error);\n    }\n  };\n\n  \/\/ Fetch analytics\n  const fetchAnalytics = async () => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/analytics\/dashboard\");\n      if (response.ok) {\n        const data = await response.json();\n        setAnalytics(data);\n      }\n    } catch (error) {\n      console.error(\"Error fetching analytics:\", error);\n    }\n  };\n\n  \/\/ Fetch dashboard data\n  const fetchDashboardData = async (contactId: number) => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/dashboard\/\" + contactId);\n      if (response.ok) {\n        const data = await response.json();\n        return data;\n      }\n    } catch (error) {\n      console.error(\"Error fetching dashboard:\", error);\n    }\n    return null;\n  };\n\n  \/\/ Handle view intelligence\n  const handleViewIntelligence = async (contact: Contact) => {\n    try {\n      const dashboardData = await fetchDashboardData(contact.id);\n      if (dashboardData) {\n        const enrichedContact = {\n          ...contact,\n          dashboard: dashboardData,\n          generated_scripts: dashboardData.generated_scripts || {},\n          pain_points: dashboardData.pain_points || [],\n          talking_points: dashboardData.talking_points || [],\n          trigger_events: dashboardData.trigger_events || []\n        };\n        setSelectedContact(enrichedContact);\n      } else {\n        setSelectedContact(contact);\n      }\n      setShowEnrichmentView(true);\n    } catch (error) {\n      console.error(\"Error:\", error);\n      setSelectedContact(contact);\n      setShowEnrichmentView(true);\n    }\n  };\n\n  \/\/ View raw data\n  const handleViewRawData = async (contact: Contact) => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/dashboard\/\" + contact.id);\n      if (response.ok) {\n        const data = await response.json();\n        setSelectedRawData(data);\n        setShowRawData(true);\n      }\n    } catch (error) {\n      console.error(\"Error viewing raw data:\", error);\n    }\n  };\n\n  \/\/ Trigger enrichment\n  const triggerEnrichment = async (contactId: number) => {\n    try {\n      setIsLoading(true);\n      const response = await fetch(API_BASE + \"\/api\/contacts\/\" + contactId + \"\/deep-enrich\", { \n        method: \"POST\" \n      });\n      if (response.ok) {\n        console.log(\"Enrichment started for contact\", contactId);\n        setTimeout(() => {\n          fetchContacts();\n          fetchAnalytics();\n        }, 3000);\n      }\n    } catch (error) {\n      console.error(\"Error:\", error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  \/\/ Generate scripts\n  const generateScripts = async (contactId: number) => {\n    try {\n      setIsLoading(true);\n      const response = await fetch(API_BASE + \"\/api\/contacts\/\" + contactId + \"\/generate-scripts\", {\n        method: \"POST\"\n      });\n      if (response.ok) {\n        const scripts = await response.json();\n        alert(\"Scripts generated successfully! View in Intelligence Report.\");\n        fetchContacts();\n      }\n    } catch (error) {\n      console.error(\"Error generating scripts:\", error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  \/\/ Import contacts from CSV\n  const handleImportContacts = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    const formData = new FormData();\n    formData.append(\"file\", file);\n\n    try {\n      setIsLoading(true);\n      const response = await fetch(API_BASE + \"\/api\/import\/contacts\", {\n        method: \"POST\",\n        body: formData\n      });\n\n      if (response.ok) {\n        const result = await response.json();\n        alert(\"Imported \" + result.count + \" contacts successfully!\");\n        fetchContacts();\n        fetchAnalytics();\n      }\n    } catch (error) {\n      console.error(\"Error importing contacts:\", error);\n      alert(\"Failed to import contacts\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  \/\/ Export contacts\n  const handleExportContacts = async () => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/export\/contacts\");\n      if (response.ok) {\n        const blob = await response.blob();\n        const url = window.URL.createObjectURL(blob);\n        const a = document.createElement(\"a\");\n        a.href = url;\n        a.download = \"contacts_export.csv\";\n        a.click();\n      }\n    } catch (error) {\n      console.error(\"Error exporting contacts:\", error);\n    }\n  };\n\n  \/\/ Batch enrichment\n  const handleBatchEnrich = async () => {\n    if (selectedContacts.size === 0) {\n      alert(\"Please select contacts to enrich\");\n      return;\n    }\n\n    setShowBatchProgress(true);\n    const contactIds = Array.from(selectedContacts);\n\n    for (const id of contactIds) {\n      await triggerEnrichment(id);\n      await new Promise(resolve => setTimeout(resolve, 1000));\n    }\n\n    setShowBatchProgress(false);\n    setSelectedContacts(new Set());\n    fetchContacts();\n  };\n\n  \/\/ Handle sort\n  const handleSort = (key: keyof Contact) => {\n    setSortConfig({\n      key,\n      direction: sortConfig.key === key && sortConfig.direction === \"asc\" ? \"desc\" : \"asc\",\n    });\n  };\n\n  \/\/ Toggle selection\n  const toggleContactSelection = (id: number) => {\n    const newSelected = new Set(selectedContacts);\n    if (newSelected.has(id)) {\n      newSelected.delete(id);\n    } else {\n      newSelected.add(id);\n    }\n    setSelectedContacts(newSelected);\n  };\n\n  \/\/ Filtered contacts\n  const filteredContacts = useMemo(() => {\n    let filtered = contacts;\n\n    if (searchTerm) {\n      filtered = filtered.filter(c =>\n        c.name?.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        c.company?.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        c.email?.toLowerCase().includes(searchTerm.toLowerCase())\n      );\n    }\n\n    if (filterStatus !== \"all\") {\n      filtered = filtered.filter(c => c.enrichment_status === filterStatus);\n    }\n\n    filtered.sort((a, b) => {\n      const aVal = a[sortConfig.key];\n      const bVal = b[sortConfig.key];\n\n      if (aVal === null || aVal === undefined) return 1;\n      if (bVal === null || bVal === undefined) return -1;\n\n      if (typeof aVal === \"string\" && typeof bVal === \"string\") {\n        return sortConfig.direction === \"asc\"\n          ? aVal.localeCompare(bVal)\n          : bVal.localeCompare(aVal);\n      }\n\n      if (typeof aVal === \"number\" && typeof bVal === \"number\") {\n        return sortConfig.direction === \"asc\" ? aVal - bVal : bVal - aVal;\n      }\n\n      return 0;\n    });\n\n    return filtered;\n  }, [contacts, searchTerm, filterStatus, sortConfig]);\n\n  \/\/ Initial load\n  useEffect(() => {\n    fetchContacts();\n    fetchAnalytics();\n    const interval = setInterval(() => {\n      fetchContacts();\n      fetchAnalytics();\n    }, 30000);\n    return () => clearInterval(interval);\n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900\">\n      {\/* Hidden file input for import *\/}\n      <input\n        ref={fileInputRef}\n        type=\"file\"\n        accept=\".csv\"\n        onChange={handleImportContacts}\n        style={{ display: \"none\" }}\n      \/>\n\n      {\/* Header *\/}\n      <header className=\"bg-slate-800\/50 border-b border-slate-700 backdrop-blur-sm sticky top-0 z-40\">\n        <div className=\"max-w-7xl mx-auto px-6 py-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-lg flex items-center justify-center\">\n                <Brain className=\"w-6 h-6 text-white\" \/>\n              <\/div>\n              <div>\n                <h1 className=\"text-2xl font-bold text-white\">\n                  APEX Sales Intelligence\n                <\/h1>\n                <p className=\"text-sm text-slate-400\">\n                  AI-Powered Contact Enrichment & Script Generation\n                <\/p>\n              <\/div>\n            <\/div>\n            <div className=\"flex items-center gap-4\">\n              <button\n                onClick={() => fileInputRef.current?.click()}\n                className=\"px-4 py-2 bg-slate-700 text-white rounded-lg hover:bg-slate-600 flex items-center gap-2\"\n                title=\"Import Contacts\"\n              >\n                <Upload className=\"w-4 h-4\" \/>\n                Import\n              <\/button>\n              <button\n                onClick={handleExportContacts}\n                className=\"px-4 py-2 bg-slate-700 text-white rounded-lg hover:bg-slate-600 flex items-center gap-2\"\n                title=\"Export Contacts\"\n              >\n                <Download className=\"w-4 h-4\" \/>\n                Export\n              <\/button>\n              <button\n                onClick={() => {\n                  fetchContacts();\n                  fetchAnalytics();\n                }}\n                className=\"p-2 text-slate-400 hover:text-white hover:bg-slate-700 rounded-lg\"\n              >\n                <RefreshCw className={isLoading ? \"w-5 h-5 animate-spin\" : \"w-5 h-5\"} \/>\n              <\/button>\n            <\/div>\n          <\/div>\n        <\/div>\n      <\/header>\n\n      {\/* Main Content *\/}\n      <main className=\"max-w-7xl mx-auto px-6 py-8\">\n        {\/* Analytics Cards *\/}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8\">\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Users className=\"w-5 h-5 text-cyan-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.total_contacts}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Total Contacts<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <CheckCircle2 className=\"w-5 h-5 text-green-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.enriched_contacts}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Enriched<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Clock className=\"w-5 h-5 text-yellow-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.pending_enrichment}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Pending<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <TrendingUp className=\"w-5 h-5 text-purple-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {Math.round(analytics.avg_opportunity_score)}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Avg Score<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Sparkles className=\"w-5 h-5 text-orange-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.contacts_last_30_days}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Last 30 Days<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Zap className=\"w-5 h-5 text-red-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.high_priority_contacts}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">High Priority<\/div>\n          <\/div>\n        <\/div>\n\n        {\/* Tabs *\/}\n        <div className=\"flex gap-2 mb-6 border-b border-slate-700\">\n          <button\n            onClick={() => setActiveTab(\"contacts\")}\n            className={activeTab === \"contacts\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <Users className=\"w-4 h-4 inline mr-2\" \/>\n            Contacts\n          <\/button>\n          <button\n            onClick={() => setActiveTab(\"intelligence\")}\n            className={activeTab === \"intelligence\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <Brain className=\"w-4 h-4 inline mr-2\" \/>\n            APEX Intelligence\n          <\/button>\n          <button\n            onClick={() => setActiveTab(\"cadence\")}\n            className={activeTab === \"cadence\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <MessageSquare className=\"w-4 h-4 inline mr-2\" \/>\n            Cadence\n          <\/button>\n          <button\n            onClick={() => setActiveTab(\"rawdata\")}\n            className={activeTab === \"rawdata\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <Database className=\"w-4 h-4 inline mr-2\" \/>\n            Raw Data\n          <\/button>\n        <\/div>\n\n        {\/* Contacts Tab Content *\/}\n        {activeTab === \"contacts\" && (\n          <>\n            {\/* Toolbar *\/}\n            <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-4 border border-slate-700 mb-6\">\n              <div className=\"flex items-center justify-between gap-4\">\n                <div className=\"flex-1 flex items-center gap-4\">\n                  <div className=\"relative flex-1 max-w-md\">\n                    <Search className=\"absolute left-3 top-1\/2 transform -translate-y-1\/2 w-5 h-5 text-slate-400\" \/>\n                    <input\n                      type=\"text\"\n                      placeholder=\"Search contacts...\"\n                      value={searchTerm}\n                      onChange={(e) => setSearchTerm(e.target.value)}\n                      className=\"w-full pl-10 pr-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500\"\n                    \/>\n                  <\/div>\n\n                  <select\n                    value={filterStatus}\n                    onChange={(e) => setFilterStatus(e.target.value)}\n                    className=\"px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white focus:outline-none focus:border-cyan-500\"\n                  >\n                    <option value=\"all\">All Status<\/option>\n                    <option value=\"pending\">Pending<\/option>\n                    <option value=\"complete\">Complete<\/option>\n                  <\/select>\n\n                  <button\n                    onClick={() => setViewMode(viewMode === \"list\" ? \"card\" : \"list\")}\n                    className=\"px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white hover:bg-slate-800\"\n                  >\n                    {viewMode === \"list\" ? (\n                      <><Grid className=\"w-4 h-4 inline mr-2\" \/>Card View<\/>\n                    ) : (\n                      <><List className=\"w-4 h-4 inline mr-2\" \/>List View<\/>\n                    )}\n                  <\/button>\n                <\/div>\n\n                {selectedContacts.size > 0 && (\n                  <button\n                    onClick={handleBatchEnrich}\n                    className=\"px-6 py-2 bg-gradient-to-r from-cyan-600 to-blue-600 text-white rounded-lg font-medium\"\n                  >\n                    <Zap className=\"w-4 h-4 inline mr-2\" \/>\n                    Enrich ({selectedContacts.size})\n                  <\/button>\n                )}\n              <\/div>\n            <\/div>\n\n            {\/* List View *\/}\n            {viewMode === \"list\" && (\n              <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden\">\n                <table className=\"w-full\">\n                  <thead className=\"bg-slate-900\/50\">\n                    <tr>\n                      <th className=\"px-6 py-4 text-left\">\n                        <input\n                          type=\"checkbox\"\n                          onChange={(e) => {\n                            if (e.target.checked) {\n                              setSelectedContacts(new Set(contacts.map(c => c.id)));\n                            } else {\n                              setSelectedContacts(new Set());\n                            }\n                          }}\n                          className=\"rounded border-slate-600\"\n                        \/>\n                      <\/th>\n                      <th \n                        className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300 cursor-pointer\"\n                        onClick={() => handleSort(\"name\")}\n                      >\n                        Name\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Company\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Title\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Score\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Status\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Actions\n                      <\/th>\n                    <\/tr>\n                  <\/thead>\n                  <tbody className=\"divide-y divide-slate-700\">\n                    {filteredContacts.map(contact => (\n                      <tr key={contact.id} className=\"hover:bg-slate-700\/30\">\n                        <td className=\"px-6 py-4\">\n                          <input\n                            type=\"checkbox\"\n                            checked={selectedContacts.has(contact.id)}\n                            onChange={() => toggleContactSelection(contact.id)}\n                            className=\"rounded border-slate-600\"\n                          \/>\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          <div className=\"text-white font-medium\">{contact.name}<\/div>\n                          <div className=\"text-sm text-slate-400\">{contact.email}<\/div>\n                        <\/td>\n                        <td className=\"px-6 py-4 text-slate-300\">\n                          {contact.company || \"-\"}\n                        <\/td>\n                        <td className=\"px-6 py-4 text-slate-300\">\n                          {contact.title || \"-\"}\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          {contact.opportunity_score ? (\n                            <div className=\"flex items-center gap-2\">\n                              <div className=\"w-16 h-2 bg-slate-700 rounded-full overflow-hidden\">\n                                <div\n                                  className=\"h-full bg-gradient-to-r from-cyan-500 to-blue-600\"\n                                  style={{ width: contact.opportunity_score + \"%\" }}\n                                \/>\n                              <\/div>\n                              <span className=\"text-sm text-slate-300\">\n                                {contact.opportunity_score}\n                              <\/span>\n                            <\/div>\n                          ) : (\n                            <span className=\"text-slate-500\">-<\/span>\n                          )}\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          {contact.enrichment_status === \"complete\" ? (\n                            <span className=\"px-2 py-1 bg-green-500\/20 text-green-400 rounded text-xs font-medium\">\n                              Complete\n                            <\/span>\n                          ) : (\n                            <span className=\"px-2 py-1 bg-gray-500\/20 text-gray-400 rounded text-xs font-medium\">\n                              Pending\n                            <\/span>\n                          )}\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          <div className=\"flex items-center gap-2\">\n                            <button\n                              onClick={() => handleViewIntelligence(contact)}\n                              className=\"p-2 text-cyan-400 hover:bg-slate-700 rounded-lg\"\n                              title=\"View Intelligence\"\n                            >\n                              <Eye className=\"w-4 h-4\" \/>\n                            <\/button>\n                            {contact.enrichment_status !== \"complete\" && (\n                              <button\n                                onClick={() => triggerEnrichment(contact.id)}\n                                className=\"p-2 text-purple-400 hover:bg-slate-700 rounded-lg\"\n                                title=\"Enrich\"\n                              >\n                                <Zap className=\"w-4 h-4\" \/>\n                              <\/button>\n                            )}\n                            {contact.enrichment_status === \"complete\" && (\n                              <>\n                                <button\n                                  onClick={() => generateScripts(contact.id)}\n                                  className=\"p-2 text-green-400 hover:bg-slate-700 rounded-lg\"\n                                  title=\"Generate Scripts\"\n                                >\n                                  <Sparkles className=\"w-4 h-4\" \/>\n                                <\/button>\n                                <button\n                                  onClick={() => handleViewRawData(contact)}\n                                  className=\"p-2 text-blue-400 hover:bg-slate-700 rounded-lg\"\n                                  title=\"View Raw Data\"\n                                >\n                                  <Database className=\"w-4 h-4\" \/>\n                                <\/button>\n                              <\/>\n                            )}\n                          <\/div>\n                        <\/td>\n                      <\/tr>\n                    ))}\n                  <\/tbody>\n                <\/table>\n              <\/div>\n            )}\n\n            {\/* Card View *\/}\n            {viewMode === \"card\" && (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                {filteredContacts.map(contact => (\n                  <div\n                    key={contact.id}\n                    className=\"bg-slate-800\/50 backdrop-blur-sm border border-slate-700 rounded-xl p-6\"\n                  >\n                    <div className=\"flex items-start justify-between mb-4\">\n                      <div>\n                        <h3 className=\"text-lg font-semibold text-white\">\n                          {contact.name}\n                        <\/h3>\n                        <p className=\"text-sm text-cyan-400\">{contact.email}<\/p>\n                      <\/div>\n                      <input\n                        type=\"checkbox\"\n                        checked={selectedContacts.has(contact.id)}\n                        onChange={() => toggleContactSelection(contact.id)}\n                        className=\"rounded border-slate-600\"\n                      \/>\n                    <\/div>\n\n                    <div className=\"space-y-2 mb-4\">\n                      <div className=\"text-sm text-slate-300\">\n                        <Building className=\"w-4 h-4 inline mr-2 text-slate-400\" \/>\n                        {contact.company || \"No company\"}\n                      <\/div>\n                      {contact.title && (\n                        <div className=\"text-sm text-slate-300\">\n                          <Briefcase className=\"w-4 h-4 inline mr-2 text-slate-400\" \/>\n                          {contact.title}\n                        <\/div>\n                      )}\n                    <\/div>\n\n                    <div className=\"flex items-center justify-between\">\n                      <span className={\n                        contact.enrichment_status === \"complete\"\n                          ? \"px-2 py-1 bg-green-500\/20 text-green-400 rounded text-xs\"\n                          : \"px-2 py-1 bg-gray-500\/20 text-gray-400 rounded text-xs\"\n                      }>\n                        {contact.enrichment_status || \"Pending\"}\n                      <\/span>\n\n                      <div className=\"flex items-center gap-2\">\n                        <button\n                          onClick={() => handleViewIntelligence(contact)}\n                          className=\"p-2 text-cyan-400 hover:bg-slate-700 rounded-lg\"\n                        >\n                          <Eye className=\"w-4 h-4\" \/>\n                        <\/button>\n                        {contact.enrichment_status !== \"complete\" && (\n                          <button\n                            onClick={() => triggerEnrichment(contact.id)}\n                            className=\"p-2 text-purple-400 hover:bg-slate-700 rounded-lg\"\n                          >\n                            <Zap className=\"w-4 h-4\" \/>\n                          <\/button>\n                        )}\n                        {contact.enrichment_status === \"complete\" && (\n                          <button\n                            onClick={() => generateScripts(contact.id)}\n                            className=\"p-2 text-green-400 hover:bg-slate-700 rounded-lg\"\n                          >\n                            <Sparkles className=\"w-4 h-4\" \/>\n                          <\/button>\n                        )}\n                      <\/div>\n                    <\/div>\n                  <\/div>\n                ))}\n              <\/div>\n            )}\n          <\/>\n        )}\n\n        {\/* Intelligence Tab *\/}\n        {activeTab === \"intelligence\" && (\n          <ApexIntelligenceDashboard contacts={contacts} \/>\n        )}\n\n        {\/* Cadence Tab *\/}\n        {activeTab === \"cadence\" && (\n          <CadenceDashboard contacts={contacts} \/>\n        )}\n\n        {\/* Raw Data Tab *\/}\n        {activeTab === \"rawdata\" && (\n          <RawDataViewer contacts={contacts} \/>\n        )}\n      <\/main>\n\n      {\/* Modals *\/}\n      {showEnrichmentView && selectedContact && (\n        <ContactEnrichmentView\n          contact={selectedContact}\n          onClose={() => {\n            setShowEnrichmentView(false);\n            setSelectedContact(null);\n            fetchContacts();\n          }}\n        \/>\n      )}\n\n      {showBatchProgress && (\n        <BatchProgress\n          totalContacts={selectedContacts.size}\n          onClose={() => setShowBatchProgress(false)}\n        \/>\n      )}\n\n      {\/* Raw Data Modal *\/}\n      {showRawData && selectedRawData && (\n        <div className=\"fixed inset-0 bg-black\/50 backdrop-blur-sm flex items-center justify-center p-6 z-50\">\n          <div className=\"bg-slate-800 rounded-xl border border-slate-700 max-w-4xl w-full max-h-[80vh] overflow-hidden flex flex-col\">\n            <div className=\"p-6 border-b border-slate-700 flex items-center justify-between\">\n              <h2 className=\"text-xl font-semibold text-white\">Raw Data<\/h2>\n              <button\n                onClick={() => {\n                  setShowRawData(false);\n                  setSelectedRawData(null);\n                }}\n                className=\"text-slate-400 hover:text-white\"\n              >\n                <X className=\"w-6 h-6\" \/>\n              <\/button>\n            <\/div>\n            <div className=\"p-6 overflow-y-auto\">\n              <pre className=\"bg-slate-900 rounded-lg p-4 text-sm text-green-400 overflow-x-auto\">\n                {JSON.stringify(selectedRawData, null, 2)}\n              <\/pre>\n            <\/div>\n          <\/div>\n        <\/div>\n      )}\n    <\/div>\n  );\n}\n\nexport default App;\n\n\nimport React, { useEffect, useMemo, useState, useRef } from \"react\";\nimport {\n  Search,\n  Users,\n  TrendingUp,\n  Brain,\n  Sparkles,\n  Zap,\n  RefreshCw,\n  Clock,\n  List,\n  Grid,\n  ArrowUpDown,\n  CheckCircle2,\n  Eye,\n  Mail,\n  Phone,\n  MessageSquare,\n  Building,\n  Briefcase,\n  X,\n  Upload,\n  FileText,\n  Database,\n  Download\n} from \"lucide-react\";\nimport ContactEnrichmentView from \".\/components\/ContactEnrichmentView\";\nimport ContactDetailModal from \".\/components\/ContactDetailModal\";\nimport CadenceDashboard from \".\/components\/CadenceDashboard\";\nimport RawDataViewer from \".\/components\/RawDataViewer\";\nimport { ApexIntelligenceDashboard } from \".\/components\/ApexIntelligence\";\nimport BatchProgress from \".\/components\/BatchProgress\";\n\n\/\/ TYPE DEFINITIONS\nexport interface Contact {\n  id: number;\n  hubspot_id?: string;\n  name: string;\n  firstname?: string;\n  lastname?: string;\n  title: string | null;\n  company: string | null;\n  email: string | null;\n  phone?: string | null;\n  linkedin_url?: string | null;\n  enrichment_status?: \"pending\" | \"processing\" | \"complete\" | \"failed\" | null;\n  enrichment_data?: any;\n  opportunity_score?: number;\n  dashboard?: any;\n  generated_scripts?: any;\n  pain_points?: string[];\n  talking_points?: string[];\n  trigger_events?: string[];\n  mdcp_score?: number;\n  rss_score?: number;\n  priority_score?: number;\n}\n\ninterface Analytics {\n  total_contacts: number;\n  enriched_contacts: number;\n  pending_enrichment: number;\n  avg_opportunity_score: number;\n  contacts_last_30_days: number;\n  high_priority_contacts: number;\n}\n\nfunction App() {\n  const [contacts, setContacts] = useState<Contact[]>([]);\n  const [analytics, setAnalytics] = useState<Analytics>({\n    total_contacts: 0,\n    enriched_contacts: 0,\n    pending_enrichment: 0,\n    avg_opportunity_score: 0,\n    contacts_last_30_days: 0,\n    high_priority_contacts: 0,\n  });\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [filterStatus, setFilterStatus] = useState(\"all\");\n  const [selectedContact, setSelectedContact] = useState<Contact | null>(null);\n  const [showEnrichmentView, setShowEnrichmentView] = useState(false);\n  const [selectedContacts, setSelectedContacts] = useState<Set<number>>(new Set());\n  const [isLoading, setIsLoading] = useState(false);\n  const [activeTab, setActiveTab] = useState(\"contacts\");\n  const [viewMode, setViewMode] = useState<\"list\" | \"card\">(\"list\");\n  const [showBatchProgress, setShowBatchProgress] = useState(false);\n  const [sortConfig, setSortConfig] = useState<{\n    key: keyof Contact;\n    direction: \"asc\" | \"desc\";\n  }>({ key: \"name\", direction: \"asc\" });\n  const [showRawData, setShowRawData] = useState(false);\n  const [selectedRawData, setSelectedRawData] = useState<any>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const API_BASE = \"http:\/\/localhost:8000\";\n\n  \/\/ Fetch contacts\n  const fetchContacts = async () => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/contacts\");\n      if (response.ok) {\n        const data = await response.json();\n        const contactsList = Array.isArray(data) ? data : (data.contacts || []);\n        setContacts(contactsList);\n      }\n    } catch (error) {\n      console.error(\"Error fetching contacts:\", error);\n    }\n  };\n\n  \/\/ Fetch analytics\n  const fetchAnalytics = async () => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/analytics\/dashboard\");\n      if (response.ok) {\n        const data = await response.json();\n        setAnalytics(data);\n      }\n    } catch (error) {\n      console.error(\"Error fetching analytics:\", error);\n    }\n  };\n\n  \/\/ Fetch dashboard data\n  const fetchDashboardData = async (contactId: number) => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/dashboard\/\" + contactId);\n      if (response.ok) {\n        const data = await response.json();\n        return data;\n      }\n    } catch (error) {\n      console.error(\"Error fetching dashboard:\", error);\n    }\n    return null;\n  };\n\n  \/\/ Handle view intelligence\n  const handleViewIntelligence = async (contact: Contact) => {\n    try {\n      const dashboardData = await fetchDashboardData(contact.id);\n      if (dashboardData) {\n        const enrichedContact = {\n          ...contact,\n          dashboard: dashboardData,\n          generated_scripts: dashboardData.generated_scripts || {},\n          pain_points: dashboardData.pain_points || [],\n          talking_points: dashboardData.talking_points || [],\n          trigger_events: dashboardData.trigger_events || []\n        };\n        setSelectedContact(enrichedContact);\n      } else {\n        setSelectedContact(contact);\n      }\n      setShowEnrichmentView(true);\n    } catch (error) {\n      console.error(\"Error:\", error);\n      setSelectedContact(contact);\n      setShowEnrichmentView(true);\n    }\n  };\n\n  \/\/ View raw data\n  const handleViewRawData = async (contact: Contact) => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/dashboard\/\" + contact.id);\n      if (response.ok) {\n        const data = await response.json();\n        setSelectedRawData(data);\n        setShowRawData(true);\n      }\n    } catch (error) {\n      console.error(\"Error viewing raw data:\", error);\n    }\n  };\n\n  \/\/ Trigger enrichment\n  const triggerEnrichment = async (contactId: number) => {\n    try {\n      setIsLoading(true);\n      const response = await fetch(API_BASE + \"\/api\/contacts\/\" + contactId + \"\/deep-enrich\", { \n        method: \"POST\" \n      });\n      if (response.ok) {\n        console.log(\"Enrichment started for contact\", contactId);\n        setTimeout(() => {\n          fetchContacts();\n          fetchAnalytics();\n        }, 3000);\n      }\n    } catch (error) {\n      console.error(\"Error:\", error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  \/\/ Generate scripts\n  const generateScripts = async (contactId: number) => {\n    try {\n      setIsLoading(true);\n      const response = await fetch(API_BASE + \"\/api\/contacts\/\" + contactId + \"\/generate-scripts\", {\n        method: \"POST\"\n      });\n      if (response.ok) {\n        const scripts = await response.json();\n        alert(\"Scripts generated successfully! View in Intelligence Report.\");\n        fetchContacts();\n      }\n    } catch (error) {\n      console.error(\"Error generating scripts:\", error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  \/\/ Import contacts from CSV\n  const handleImportContacts = async (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n    if (!file) return;\n\n    const formData = new FormData();\n    formData.append(\"file\", file);\n\n    try {\n      setIsLoading(true);\n      const response = await fetch(API_BASE + \"\/api\/import\/contacts\", {\n        method: \"POST\",\n        body: formData\n      });\n\n      if (response.ok) {\n        const result = await response.json();\n        alert(\"Imported \" + result.count + \" contacts successfully!\");\n        fetchContacts();\n        fetchAnalytics();\n      }\n    } catch (error) {\n      console.error(\"Error importing contacts:\", error);\n      alert(\"Failed to import contacts\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  \/\/ Export contacts\n  const handleExportContacts = async () => {\n    try {\n      const response = await fetch(API_BASE + \"\/api\/export\/contacts\");\n      if (response.ok) {\n        const blob = await response.blob();\n        const url = window.URL.createObjectURL(blob);\n        const a = document.createElement(\"a\");\n        a.href = url;\n        a.download = \"contacts_export.csv\";\n        a.click();\n      }\n    } catch (error) {\n      console.error(\"Error exporting contacts:\", error);\n    }\n  };\n\n  \/\/ Batch enrichment\n  const handleBatchEnrich = async () => {\n    if (selectedContacts.size === 0) {\n      alert(\"Please select contacts to enrich\");\n      return;\n    }\n\n    setShowBatchProgress(true);\n    const contactIds = Array.from(selectedContacts);\n\n    for (const id of contactIds) {\n      await triggerEnrichment(id);\n      await new Promise(resolve => setTimeout(resolve, 1000));\n    }\n\n    setShowBatchProgress(false);\n    setSelectedContacts(new Set());\n    fetchContacts();\n  };\n\n  \/\/ Handle sort\n  const handleSort = (key: keyof Contact) => {\n    setSortConfig({\n      key,\n      direction: sortConfig.key === key && sortConfig.direction === \"asc\" ? \"desc\" : \"asc\",\n    });\n  };\n\n  \/\/ Toggle selection\n  const toggleContactSelection = (id: number) => {\n    const newSelected = new Set(selectedContacts);\n    if (newSelected.has(id)) {\n      newSelected.delete(id);\n    } else {\n      newSelected.add(id);\n    }\n    setSelectedContacts(newSelected);\n  };\n\n  \/\/ Filtered contacts\n  const filteredContacts = useMemo(() => {\n    let filtered = contacts;\n\n    if (searchTerm) {\n      filtered = filtered.filter(c =>\n        c.name?.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        c.company?.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        c.email?.toLowerCase().includes(searchTerm.toLowerCase())\n      );\n    }\n\n    if (filterStatus !== \"all\") {\n      filtered = filtered.filter(c => c.enrichment_status === filterStatus);\n    }\n\n    filtered.sort((a, b) => {\n      const aVal = a[sortConfig.key];\n      const bVal = b[sortConfig.key];\n\n      if (aVal === null || aVal === undefined) return 1;\n      if (bVal === null || bVal === undefined) return -1;\n\n      if (typeof aVal === \"string\" && typeof bVal === \"string\") {\n        return sortConfig.direction === \"asc\"\n          ? aVal.localeCompare(bVal)\n          : bVal.localeCompare(aVal);\n      }\n\n      if (typeof aVal === \"number\" && typeof bVal === \"number\") {\n        return sortConfig.direction === \"asc\" ? aVal - bVal : bVal - aVal;\n      }\n\n      return 0;\n    });\n\n    return filtered;\n  }, [contacts, searchTerm, filterStatus, sortConfig]);\n\n  \/\/ Initial load\n  useEffect(() => {\n    fetchContacts();\n    fetchAnalytics();\n    const interval = setInterval(() => {\n      fetchContacts();\n      fetchAnalytics();\n    }, 30000);\n    return () => clearInterval(interval);\n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900\">\n      {\/* Hidden file input for import *\/}\n      <input\n        ref={fileInputRef}\n        type=\"file\"\n        accept=\".csv\"\n        onChange={handleImportContacts}\n        style={{ display: \"none\" }}\n      \/>\n\n      {\/* Header *\/}\n      <header className=\"bg-slate-800\/50 border-b border-slate-700 backdrop-blur-sm sticky top-0 z-40\">\n        <div className=\"max-w-7xl mx-auto px-6 py-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-lg flex items-center justify-center\">\n                <Brain className=\"w-6 h-6 text-white\" \/>\n              <\/div>\n              <div>\n                <h1 className=\"text-2xl font-bold text-white\">\n                  APEX Sales Intelligence\n                <\/h1>\n                <p className=\"text-sm text-slate-400\">\n                  AI-Powered Contact Enrichment & Script Generation\n                <\/p>\n              <\/div>\n            <\/div>\n            <div className=\"flex items-center gap-4\">\n              <button\n                onClick={() => fileInputRef.current?.click()}\n                className=\"px-4 py-2 bg-slate-700 text-white rounded-lg hover:bg-slate-600 flex items-center gap-2\"\n                title=\"Import Contacts\"\n              >\n                <Upload className=\"w-4 h-4\" \/>\n                Import\n              <\/button>\n              <button\n                onClick={handleExportContacts}\n                className=\"px-4 py-2 bg-slate-700 text-white rounded-lg hover:bg-slate-600 flex items-center gap-2\"\n                title=\"Export Contacts\"\n              >\n                <Download className=\"w-4 h-4\" \/>\n                Export\n              <\/button>\n              <button\n                onClick={() => {\n                  fetchContacts();\n                  fetchAnalytics();\n                }}\n                className=\"p-2 text-slate-400 hover:text-white hover:bg-slate-700 rounded-lg\"\n              >\n                <RefreshCw className={isLoading ? \"w-5 h-5 animate-spin\" : \"w-5 h-5\"} \/>\n              <\/button>\n            <\/div>\n          <\/div>\n        <\/div>\n      <\/header>\n\n      {\/* Main Content *\/}\n      <main className=\"max-w-7xl mx-auto px-6 py-8\">\n        {\/* Analytics Cards *\/}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8\">\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Users className=\"w-5 h-5 text-cyan-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.total_contacts}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Total Contacts<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <CheckCircle2 className=\"w-5 h-5 text-green-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.enriched_contacts}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Enriched<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Clock className=\"w-5 h-5 text-yellow-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.pending_enrichment}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Pending<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <TrendingUp className=\"w-5 h-5 text-purple-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {Math.round(analytics.avg_opportunity_score)}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Avg Score<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Sparkles className=\"w-5 h-5 text-orange-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.contacts_last_30_days}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">Last 30 Days<\/div>\n          <\/div>\n\n          <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700\">\n            <Zap className=\"w-5 h-5 text-red-400 mb-2\" \/>\n            <div className=\"text-2xl font-bold text-white\">\n              {analytics.high_priority_contacts}\n            <\/div>\n            <div className=\"text-sm text-slate-400\">High Priority<\/div>\n          <\/div>\n        <\/div>\n\n        {\/* Tabs *\/}\n        <div className=\"flex gap-2 mb-6 border-b border-slate-700\">\n          <button\n            onClick={() => setActiveTab(\"contacts\")}\n            className={activeTab === \"contacts\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <Users className=\"w-4 h-4 inline mr-2\" \/>\n            Contacts\n          <\/button>\n          <button\n            onClick={() => setActiveTab(\"intelligence\")}\n            className={activeTab === \"intelligence\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <Brain className=\"w-4 h-4 inline mr-2\" \/>\n            APEX Intelligence\n          <\/button>\n          <button\n            onClick={() => setActiveTab(\"cadence\")}\n            className={activeTab === \"cadence\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <MessageSquare className=\"w-4 h-4 inline mr-2\" \/>\n            Cadence\n          <\/button>\n          <button\n            onClick={() => setActiveTab(\"rawdata\")}\n            className={activeTab === \"rawdata\"\n              ? \"px-6 py-3 font-medium border-b-2 border-cyan-500 text-cyan-400\"\n              : \"px-6 py-3 font-medium border-b-2 border-transparent text-slate-400 hover:text-white\"\n            }\n          >\n            <Database className=\"w-4 h-4 inline mr-2\" \/>\n            Raw Data\n          <\/button>\n        <\/div>\n\n        {\/* Contacts Tab Content *\/}\n        {activeTab === \"contacts\" && (\n          <>\n            {\/* Toolbar *\/}\n            <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl p-4 border border-slate-700 mb-6\">\n              <div className=\"flex items-center justify-between gap-4\">\n                <div className=\"flex-1 flex items-center gap-4\">\n                  <div className=\"relative flex-1 max-w-md\">\n                    <Search className=\"absolute left-3 top-1\/2 transform -translate-y-1\/2 w-5 h-5 text-slate-400\" \/>\n                    <input\n                      type=\"text\"\n                      placeholder=\"Search contacts...\"\n                      value={searchTerm}\n                      onChange={(e) => setSearchTerm(e.target.value)}\n                      className=\"w-full pl-10 pr-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500\"\n                    \/>\n                  <\/div>\n\n                  <select\n                    value={filterStatus}\n                    onChange={(e) => setFilterStatus(e.target.value)}\n                    className=\"px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white focus:outline-none focus:border-cyan-500\"\n                  >\n                    <option value=\"all\">All Status<\/option>\n                    <option value=\"pending\">Pending<\/option>\n                    <option value=\"complete\">Complete<\/option>\n                  <\/select>\n\n                  <button\n                    onClick={() => setViewMode(viewMode === \"list\" ? \"card\" : \"list\")}\n                    className=\"px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white hover:bg-slate-800\"\n                  >\n                    {viewMode === \"list\" ? (\n                      <><Grid className=\"w-4 h-4 inline mr-2\" \/>Card View<\/>\n                    ) : (\n                      <><List className=\"w-4 h-4 inline mr-2\" \/>List View<\/>\n                    )}\n                  <\/button>\n                <\/div>\n\n                {selectedContacts.size > 0 && (\n                  <button\n                    onClick={handleBatchEnrich}\n                    className=\"px-6 py-2 bg-gradient-to-r from-cyan-600 to-blue-600 text-white rounded-lg font-medium\"\n                  >\n                    <Zap className=\"w-4 h-4 inline mr-2\" \/>\n                    Enrich ({selectedContacts.size})\n                  <\/button>\n                )}\n              <\/div>\n            <\/div>\n\n            {\/* List View *\/}\n            {viewMode === \"list\" && (\n              <div className=\"bg-slate-800\/50 backdrop-blur-sm rounded-xl border border-slate-700 overflow-hidden\">\n                <table className=\"w-full\">\n                  <thead className=\"bg-slate-900\/50\">\n                    <tr>\n                      <th className=\"px-6 py-4 text-left\">\n                        <input\n                          type=\"checkbox\"\n                          onChange={(e) => {\n                            if (e.target.checked) {\n                              setSelectedContacts(new Set(contacts.map(c => c.id)));\n                            } else {\n                              setSelectedContacts(new Set());\n                            }\n                          }}\n                          className=\"rounded border-slate-600\"\n                        \/>\n                      <\/th>\n                      <th \n                        className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300 cursor-pointer\"\n                        onClick={() => handleSort(\"name\")}\n                      >\n                        Name\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Company\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Title\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Score\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Status\n                      <\/th>\n                      <th className=\"px-6 py-4 text-left text-sm font-semibold text-slate-300\">\n                        Actions\n                      <\/th>\n                    <\/tr>\n                  <\/thead>\n                  <tbody className=\"divide-y divide-slate-700\">\n                    {filteredContacts.map(contact => (\n                      <tr key={contact.id} className=\"hover:bg-slate-700\/30\">\n                        <td className=\"px-6 py-4\">\n                          <input\n                            type=\"checkbox\"\n                            checked={selectedContacts.has(contact.id)}\n                            onChange={() => toggleContactSelection(contact.id)}\n                            className=\"rounded border-slate-600\"\n                          \/>\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          <div className=\"text-white font-medium\">{contact.name}<\/div>\n                          <div className=\"text-sm text-slate-400\">{contact.email}<\/div>\n                        <\/td>\n                        <td className=\"px-6 py-4 text-slate-300\">\n                          {contact.company || \"-\"}\n                        <\/td>\n                        <td className=\"px-6 py-4 text-slate-300\">\n                          {contact.title || \"-\"}\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          {contact.opportunity_score ? (\n                            <div className=\"flex items-center gap-2\">\n                              <div className=\"w-16 h-2 bg-slate-700 rounded-full overflow-hidden\">\n                                <div\n                                  className=\"h-full bg-gradient-to-r from-cyan-500 to-blue-600\"\n                                  style={{ width: contact.opportunity_score + \"%\" }}\n                                \/>\n                              <\/div>\n                              <span className=\"text-sm text-slate-300\">\n                                {contact.opportunity_score}\n                              <\/span>\n                            <\/div>\n                          ) : (\n                            <span className=\"text-slate-500\">-<\/span>\n                          )}\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          {contact.enrichment_status === \"complete\" ? (\n                            <span className=\"px-2 py-1 bg-green-500\/20 text-green-400 rounded text-xs font-medium\">\n                              Complete\n                            <\/span>\n                          ) : (\n                            <span className=\"px-2 py-1 bg-gray-500\/20 text-gray-400 rounded text-xs font-medium\">\n                              Pending\n                            <\/span>\n                          )}\n                        <\/td>\n                        <td className=\"px-6 py-4\">\n                          <div className=\"flex items-center gap-2\">\n                            <button\n                              onClick={() => handleViewIntelligence(contact)}\n                              className=\"p-2 text-cyan-400 hover:bg-slate-700 rounded-lg\"\n                              title=\"View Intelligence\"\n                            >\n                              <Eye className=\"w-4 h-4\" \/>\n                            <\/button>\n                            {contact.enrichment_status !== \"complete\" && (\n                              <button\n                                onClick={() => triggerEnrichment(contact.id)}\n                                className=\"p-2 text-purple-400 hover:bg-slate-700 rounded-lg\"\n                                title=\"Enrich\"\n                              >\n                                <Zap className=\"w-4 h-4\" \/>\n                              <\/button>\n                            )}\n                            {contact.enrichment_status === \"complete\" && (\n                              <>\n                                <button\n                                  onClick={() => generateScripts(contact.id)}\n                                  className=\"p-2 text-green-400 hover:bg-slate-700 rounded-lg\"\n                                  title=\"Generate Scripts\"\n                                >\n                                  <Sparkles className=\"w-4 h-4\" \/>\n                                <\/button>\n                                <button\n                                  onClick={() => handleViewRawData(contact)}\n                                  className=\"p-2 text-blue-400 hover:bg-slate-700 rounded-lg\"\n                                  title=\"View Raw Data\"\n                                >\n                                  <Database className=\"w-4 h-4\" \/>\n                                <\/button>\n                              <\/>\n                            )}\n                          <\/div>\n                        <\/td>\n                      <\/tr>\n                    ))}\n                  <\/tbody>\n                <\/table>\n              <\/div>\n            )}\n\n            {\/* Card View *\/}\n            {viewMode === \"card\" && (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                {filteredContacts.map(contact => (\n                  <div\n                    key={contact.id}\n                    className=\"bg-slate-800\/50 backdrop-blur-sm border border-slate-700 rounded-xl p-6\"\n                  >\n                    <div className=\"flex items-start justify-between mb-4\">\n                      <div>\n                        <h3 className=\"text-lg font-semibold text-white\">\n                          {contact.name}\n                        <\/h3>\n                        <p className=\"text-sm text-cyan-400\">{contact.email}<\/p>\n                      <\/div>\n                      <input\n                        type=\"checkbox\"\n                        checked={selectedContacts.has(contact.id)}\n                        onChange={() => toggleContactSelection(contact.id)}\n                        className=\"rounded border-slate-600\"\n                      \/>\n                    <\/div>\n\n                    <div className=\"space-y-2 mb-4\">\n                      <div className=\"text-sm text-slate-300\">\n                        <Building className=\"w-4 h-4 inline mr-2 text-slate-400\" \/>\n                        {contact.company || \"No company\"}\n                      <\/div>\n                      {contact.title && (\n                        <div className=\"text-sm text-slate-300\">\n                          <Briefcase className=\"w-4 h-4 inline mr-2 text-slate-400\" \/>\n                          {contact.title}\n                        <\/div>\n                      )}\n                    <\/div>\n\n                    <div className=\"flex items-center justify-between\">\n                      <span className={\n                        contact.enrichment_status === \"complete\"\n                          ? \"px-2 py-1 bg-green-500\/20 text-green-400 rounded text-xs\"\n                          : \"px-2 py-1 bg-gray-500\/20 text-gray-400 rounded text-xs\"\n                      }>\n                        {contact.enrichment_status || \"Pending\"}\n                      <\/span>\n\n                      <div className=\"flex items-center gap-2\">\n                        <button\n                          onClick={() => handleViewIntelligence(contact)}\n                          className=\"p-2 text-cyan-400 hover:bg-slate-700 rounded-lg\"\n                        >\n                          <Eye className=\"w-4 h-4\" \/>\n                        <\/button>\n                        {contact.enrichment_status !== \"complete\" && (\n                          <button\n                            onClick={() => triggerEnrichment(contact.id)}\n                            className=\"p-2 text-purple-400 hover:bg-slate-700 rounded-lg\"\n                          >\n                            <Zap className=\"w-4 h-4\" \/>\n                          <\/button>\n                        )}\n                        {contact.enrichment_status === \"complete\" && (\n                          <button\n                            onClick={() => generateScripts(contact.id)}\n                            className=\"p-2 text-green-400 hover:bg-slate-700 rounded-lg\"\n                          >\n                            <Sparkles className=\"w-4 h-4\" \/>\n                          <\/button>\n                        )}\n                      <\/div>\n                    <\/div>\n                  <\/div>\n                ))}\n              <\/div>\n            )}\n          <\/>\n        )}\n\n        {\/* Intelligence Tab *\/}\n        {activeTab === \"intelligence\" && (\n          <ApexIntelligenceDashboard contacts={contacts} \/>\n        )}\n\n        {\/* Cadence Tab *\/}\n        {activeTab === \"cadence\" && (\n          <CadenceDashboard contacts={contacts} \/>\n        )}\n\n        {\/* Raw Data Tab *\/}\n        {activeTab === \"rawdata\" && (\n          <RawDataViewer contacts={contacts} \/>\n        )}\n      <\/main>\n\n      {\/* Modals *\/}\n      {showEnrichmentView && selectedContact && (\n        <ContactEnrichmentView\n          contact={selectedContact}\n          onClose={() => {\n            setShowEnrichmentView(false);\n            setSelectedContact(null);\n            fetchContacts();\n          }}\n        \/>\n      )}\n\n      {showBatchProgress && (\n        <BatchProgress\n          totalContacts={selectedContacts.size}\n          onClose={() => setShowBatchProgress(false)}\n        \/>\n      )}\n\n      {\/* Raw Data Modal *\/}\n      {showRawData && selectedRawData && (\n        <div className=\"fixed inset-0 bg-black\/50 backdrop-blur-sm flex items-center justify-center p-6 z-50\">\n          <div className=\"bg-slate-800 rounded-xl border border-slate-700 max-w-4xl w-full max-h-[80vh] overflow-hidden flex flex-col\">\n            <div className=\"p-6 border-b border-slate-700 flex items-center justify-between\">\n              <h2 className=\"text-xl font-semibold text-white\">Raw Data<\/h2>\n              <button\n                onClick={() => {\n                  setShowRawData(false);\n                  setSelectedRawData(null);\n                }}\n                className=\"text-slate-400 hover:text-white\"\n              >\n                <X className=\"w-6 h-6\" \/>\n              <\/button>\n            <\/div>\n            <div className=\"p-6 overflow-y-auto\">\n              <pre className=\"bg-slate-900 rounded-lg p-4 text-sm text-green-400 overflow-x-auto\">\n                {JSON.stringify(selectedRawData, null, 2)}\n              <\/pre>\n            <\/div>\n          <\/div>\n        <\/div>\n      )}\n    <\/div>\n  );\n}\n\nexport default App;\nimport React, { useEffect, useState } from \"react\";\n\ntype ApexContact = {\n  id: number;\n  name: string;\n  company: string | null;\n  email: string | null;\n  lead_type: string | null;\n  lifecycle_stage: string | null;\n  mdcp_total: number | null;\n  mdcp_tier: string | null;\n  rss_total: number | null;\n  rss_tier: string | null;\n  priority_score: number | null;\n  urgency_level: string | null;\n  recommended_action: string | null;\n};\n\ntype ApexApiResponse = {\n  status: string;\n  count: number;\n  contacts: ApexContact[];\n};\n\nexport function ApexIntelligenceDashboard() {\n  const [contacts, setContacts] = useState<ApexContact[]>([]);\n  const [loading, setLoading] = useState<boolean>(true);\n  const [error, setError] = useState<string | null>(null);\n  const [running, setRunning] = useState<boolean>(false);\n\n  const API_BASE = \"http:\/\/localhost:8000\";\n\n  useEffect(() => {\n    fetchApexScores();\n  }, []);\n\n  const fetchApexScores = async () => {\n    setLoading(true);\n    setError(null);\n\n    try {\n      const res = await fetch(`${API_BASE}\/api\/apex\/scores`);\n      if (!res.ok) {\n        throw new Error(`API returned ${res.status}`);\n      }\n      const data: ApexApiResponse = await res.json();\n      setContacts(data.contacts || []);\n    } catch (err: any) {\n      console.error(\"Error fetching Apex scores:\", err);\n      if (err?.message?.includes(\"Failed to fetch\")) {\n        setError(\n          \"Cannot reach Apex Intelligence API at http:\/\/localhost:8000. Make sure the FastAPI server is running.\"\n        );\n      } else {\n        setError(err?.message || \"Unknown error loading Apex scores.\");\n      }\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const runScoring = async () => {\n    setRunning(true);\n    setError(null);\n\n    try {\n      const res = await fetch(`${API_BASE}\/api\/apex\/score-all`, {\n        method: \"POST\",\n      });\n      if (!res.ok) {\n        throw new Error(`Score-all API returned ${res.status}`);\n      }\n      \/\/ Give backend a moment then reload scores\n      setTimeout(fetchApexScores, 1500);\n    } catch (err: any) {\n      console.error(\"Error running scoring:\", err);\n      setError(\n        err?.message ||\n          \"Error running scoring. Check backend logs for more details.\"\n      );\n    } finally {\n      setRunning(false);\n    }\n  };\n\n  const getUrgencyColor = (urgency?: string | null) => {\n    switch (urgency) {\n      case \"IMMEDIATE\":\n        return \"bg-red-500 text-white\";\n      case \"HIGH\":\n        return \"bg-orange-500 text-white\";\n      case \"MEDIUM\":\n        return \"bg-yellow-400 text-slate-900\";\n      case \"LOW\":\n        return \"bg-emerald-500 text-white\";\n      default:\n        return \"bg-slate-600 text-slate-100\";\n    }\n  };\n\n  const getTierColor = (tier?: string | null) => {\n    switch ((tier || \"\").toUpperCase()) {\n      case \"PLATINUM\":\n        return \"bg-purple-600 text-white\";\n      case \"HOT\":\n        return \"bg-red-600 text-white\";\n      case \"WARM\":\n        return \"bg-orange-500 text-white\";\n      case \"QUALIFIED\":\n        return \"bg-blue-600 text-white\";\n      case \"COLD\":\n        return \"bg-slate-600 text-white\";\n      default:\n        return \"bg-slate-700 text-slate-100\";\n    }\n  };\n\n  const immediateCount = contacts.filter(\n    (c) => c.urgency_level === \"IMMEDIATE\"\n  ).length;\n  const highCount = contacts.filter((c) => c.urgency_level === \"HIGH\").length;\n  const avgPriority =\n    contacts.length === 0\n      ? 0\n      : Math.round(\n          contacts.reduce(\n            (sum, c) => sum + (c.priority_score ?? 0),\n            0\n          ) \/ contacts.length\n        );\n\n  return (\n    <div className=\"space-y-6\">\n      {\/* Header *\/}\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h1 className=\"text-3xl font-bold text-white\">Apex Intelligence<\/h1>\n          <p className=\"text-slate-400 mt-1\">\n            MDCP + RSS scoring layered into a single prioritized action list.\n          <\/p>\n        <\/div>\n        <div className=\"flex gap-3\">\n          <button\n            onClick={fetchApexScores}\n            disabled={loading || running}\n            className=\"px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-100 rounded-lg text-sm font-medium disabled:opacity-50\"\n          >\n            Refresh\n          <\/button>\n          <button\n            onClick={runScoring}\n            disabled={running}\n            className=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium disabled:opacity-50 flex items-center gap-2\"\n          >\n            {running ? (\n              <>\n                <span className=\"w-3 h-3 rounded-full border-2 border-white border-t-transparent animate-spin\" \/>\n                Running…\n              <\/>\n            ) : (\n              <>Run Scoring<\/>\n            )}\n          <\/button>\n        <\/div>\n      <\/div>\n\n      {\/* Error banner *\/}\n      {error && (\n        <div className=\"bg-red-900\/40 border border-red-500\/60 text-red-100 px-4 py-3 rounded-lg text-sm\">\n          <p className=\"font-semibold mb-1\">Apex API Error<\/p>\n          <p>{error}<\/p>\n          <p className=\"mt-1 text-xs text-red-200\">\n            Ensure the FastAPI backend is running on port 8000 and that the\n            \/api\/apex\/scores and \/api\/apex\/score-all routes are available.\n          <\/p>\n        <\/div>\n      )}\n\n      {\/* Stats cards *\/}\n      <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n        <div className=\"bg-slate-900\/60 border border-slate-700 rounded-xl p-4\">\n          <div className=\"text-xs font-semibold text-slate-400 mb-1\">\n            Immediate Action\n          <\/div>\n          <div className=\"text-3xl font-bold text-white\">{immediateCount}<\/div>\n          <div className=\"text-xs text-slate-500 mt-1\">\n            Contacts requiring same‑day action.\n          <\/div>\n        <\/div>\n        <div className=\"bg-slate-900\/60 border border-slate-700 rounded-xl p-4\">\n          <div className=\"text-xs font-semibold text-slate-400 mb-1\">\n            High Priority\n          <\/div>\n          <div className=\"text-3xl font-bold text-white\">{highCount}<\/div>\n          <div className=\"text-xs text-slate-500 mt-1\">\n            Strong deals worth scheduling this week.\n          <\/div>\n        <\/div>\n        <div className=\"bg-slate-900\/60 border border-slate-700 rounded-xl p-4\">\n          <div className=\"text-xs font-semibold text-slate-400 mb-1\">\n            Average Priority\n          <\/div>\n          <div className=\"text-3xl font-bold text-white\">{avgPriority}<\/div>\n          <div className=\"text-xs text-slate-500 mt-1\">\n            Mean blended MDCP\/RSS across scored contacts.\n          <\/div>\n        <\/div>\n        <div className=\"bg-slate-900\/60 border border-slate-700 rounded-xl p-4\">\n          <div className=\"text-xs font-semibold text-slate-400 mb-1\">\n            Total Scored\n          <\/div>\n          <div className=\"text-3xl font-bold text-white\">\n            {contacts.length}\n          <\/div>\n          <div className=\"text-xs text-slate-500 mt-1\">\n            Contacts with Apex Intelligence scores.\n          <\/div>\n        <\/div>\n      <\/div>\n\n      {\/* Contacts table *\/}\n      <div className=\"bg-slate-900\/60 border border-slate-800 rounded-xl overflow-hidden\">\n        <div className=\"px-6 py-4 border-b border-slate-800 flex items-center justify-between\">\n          <h2 className=\"text-lg font-semibold text-white\">\n            Priority Contacts\n          <\/h2>\n          <p className=\"text-xs text-slate-400\">\n            Sorted by blended priority score (MDCP × RSS).\n          <\/p>\n        <\/div>\n        <div className=\"overflow-x-auto\">\n          {loading ? (\n            <div className=\"p-8 text-center text-slate-400\">Loading…<\/div>\n          ) : contacts.length === 0 ? (\n            <div className=\"p-8 text-center text-slate-400 text-sm\">\n              No Apex Intelligence scores found yet. Enrich some contacts from\n              the Contacts tab, then run scoring.\n            <\/div>\n          ) : (\n            <table className=\"min-w-full text-sm\">\n              <thead className=\"bg-slate-900 border-b border-slate-800\">\n                <tr>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Name\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Company\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Type\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Lifecycle\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    MDCP\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    RSS\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Priority\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Urgency\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Action\n                  <\/th>\n                <\/tr>\n              <\/thead>\n              <tbody className=\"divide-y divide-slate-800\">\n                {contacts\n                  .slice()\n                  .sort(\n                    (a, b) =>\n                      (b.priority_score ?? 0) - (a.priority_score ?? 0)\n                  )\n                  .map((c) => (\n                    <tr key={c.id} className=\"hover:bg-slate-800\/60\">\n                      <td className=\"px-4 py-3\">\n                        <div className=\"font-semibold text-white\">\n                          {c.name}\n                        <\/div>\n                        <div className=\"text-xs text-slate-400\">\n                          {c.email || \"No email\"}\n                        <\/div>\n                      <\/td>\n                      <td className=\"px-4 py-3 text-slate-200\">\n                        {c.company || \"—\"}\n                      <\/td>\n                      <td className=\"px-4 py-3\">\n                        <span className=\"inline-flex items-center px-2 py-1 rounded-full bg-slate-800 text-xs text-slate-200 border border-slate-700\">\n                          {c.lead_type || \"UNKNOWN\"}\n                        <\/span>\n                      <\/td>\n                      <td className=\"px-4 py-3 text-slate-200\">\n                        {c.lifecycle_stage || \"—\"}\n                      <\/td>\n                      <td className=\"px-4 py-3\">\n                        {c.mdcp_total != null ? (\n                          <span\n                            className={`inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ${getTierColor(\n                              c.mdcp_tier\n                            )}`}\n                          >\n                            {c.mdcp_total.toFixed(0)}{\" \"}\n                            {c.mdcp_tier ? `• ${c.mdcp_tier}` : \"\"}\n                          <\/span>\n                        ) : (\n                          <span className=\"text-slate-500 text-xs\">—<\/span>\n                        )}\n                      <\/td>\n                      <td className=\"px-4 py-3\">\n                        {c.rss_total != null ? (\n                          <span\n                            className={`inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ${getTierColor(\n                              c.rss_tier\n                            )}`}\n                          >\n                            {c.rss_total.toFixed(0)}{\" \"}\n                            {c.rss_tier ? `• ${c.rss_tier}` : \"\"}\n                          <\/span>\n                        ) : (\n                          <span className=\"text-slate-500 text-xs\">—<\/span>\n                        )}\n                      <\/td>\n                      <td className=\"px-4 py-3\">\n                        <div className=\"text-white font-semibold\">\n                          {c.priority_score?.toFixed(0) ?? \"—\"}\n                        <\/div>\n                      <\/td>\n                      <td className=\"px-4 py-3\">\n                        <span\n                          className={`inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ${getUrgencyColor(\n                            c.urgency_level\n                          )}`}\n                        >\n                          {c.urgency_level || \"N\/A\"}\n                        <\/span>\n                      <\/td>\n                      <td className=\"px-4 py-3 text-xs text-slate-300 max-w-xs\">\n                        {c.recommended_action || \"No recommendation.\"}\n                      <\/td>\n                    <\/tr>\n                  ))}\n              <\/tbody>\n            <\/table>\n          )}\n        <\/div>\n      <\/div>\n    <\/div>\n  );\n}\nimport React from 'react';\nimport { Sparkles, CheckCircle2, RefreshCw } from 'lucide-react';\n\ninterface Props {\n  isProcessing: boolean;\n  progress: number;\n  current: number;\n  total: number;\n  currentContact?: string;\n}\n\nexport default function BatchProgress({ \n  isProcessing, \n  progress, \n  current, \n  total, \n  currentContact \n}: Props) {\n  \n  if (!isProcessing) return null;\n\n  return (\n    <div className=\"fixed inset-0 bg-black\/80 backdrop-blur-sm z-50 flex items-center justify-center\">\n      <div className=\"bg-slate-800 rounded-2xl border border-slate-700 p-8 max-w-md w-full\">\n        <div className=\"text-center mb-6\">\n          <div className=\"inline-flex items-center justify-center w-16 h-16 bg-purple-600\/20 rounded-full mb-4\">\n            {progress === 100 ? (\n              <CheckCircle2 className=\"w-8 h-8 text-green-400\" \/>\n            ) : (\n              <RefreshCw className=\"w-8 h-8 text-purple-400 animate-spin\" \/>\n            )}\n          <\/div>\n          \n          <h3 className=\"text-xl font-bold text-white mb-2\">\n            {progress === 100 ? 'Enrichment Complete!' : 'Enriching Contacts...'}\n          <\/h3>\n          \n          <p className=\"text-slate-400\">\n            {current} of {total} contacts processed\n          <\/p>\n          \n          {currentContact && (\n            <p className=\"text-sm text-slate-500 mt-2\">\n              Currently processing: {currentContact}\n            <\/p>\n          )}\n        <\/div>\n\n        <div className=\"space-y-2\">\n          <div className=\"flex justify-between text-sm text-slate-400\">\n            <span>Progress<\/span>\n            <span>{Math.round(progress)}%<\/span>\n          <\/div>\n          \n          <div className=\"w-full bg-slate-700 rounded-full h-3 overflow-hidden\">\n            <div\n              className=\"h-full bg-gradient-to-r from-purple-500 to-blue-500 transition-all duration-500\"\n              style={{ width: `${progress}%` }}\n            \/>\n          <\/div>\n        <\/div>\n\n        {progress === 100 && (\n          <button\n            onClick={() => window.location.reload()}\n            className=\"w-full mt-6 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-all\"\n          >\n            View Results\n          <\/button>\n        )}\n      <\/div>\n    <\/div>\n  );\n}\nimport React, { useEffect, useState } from \"react\";\nimport {\n  Zap,\n  Clock,\n  AlertCircle,\n  RefreshCw,\n  CheckCircle2,\n} from \"lucide-react\";\n\ntype CadenceSequenceContact = {\n  id: number;\n  name: string;\n  email: string | null;\n  company: string | null;\n  tier: string | null;\n};\n\ntype CadenceSequence = {\n  id: number;\n  cadence_type: string;\n  current_step: number;\n  total_steps: number;\n  started_at: string | null;\n  next_touch_at: string | null;\n  contact: CadenceSequenceContact;\n};\n\ntype ActiveCadenceResponse = {\n  sequences: CadenceSequence[];\n  count: number;\n};\n\ntype Summary = {\n  active_cadences: number;\n  completed_cadences: number;\n  todays_activities: number;\n  overdue_activities: number;\n};\n\nconst API_BASE = \"http:\/\/localhost:3000\";\n\nexport default function CadenceDashboard() {\n  const [summary, setSummary] = useState<Summary>({\n    active_cadences: 0,\n    completed_cadences: 0,\n    todays_activities: 0,\n    overdue_activities: 0,\n  });\n  const [sequences, setSequences] = useState<CadenceSequence[]>([]);\n  const [loading, setLoading] = useState<boolean>(true);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    loadCadenceData();\n  }, []);\n\n  const loadCadenceData = async () => {\n    setLoading(true);\n    setError(null);\n\n    try {\n      const res = await fetch(`${API_BASE}\/api\/cadences\/active`);\n      if (!res.ok) {\n        throw new Error(`API returned ${res.status}`);\n      }\n      const data: ActiveCadenceResponse = await res.json();\n      const list = data.sequences || [];\n\n      const now = new Date();\n      const todayStr = now.toISOString().slice(0, 10);\n\n      let todays = 0;\n      let overdue = 0;\n\n      list.forEach((s) => {\n        if (!s.next_touch_at) return;\n        const d = new Date(s.next_touch_at);\n        const dateStr = d.toISOString().slice(0, 10);\n        if (dateStr === todayStr) todays += 1;\n        if (d.getTime() < now.getTime()) overdue += 1;\n      });\n\n      setSequences(list);\n      setSummary({\n        active_cadences: list.length,\n        completed_cadences: 0, \/\/ \/api\/cadences\/active only returns active ones\n        todays_activities: todays,\n        overdue_activities: overdue,\n      });\n    } catch (err: any) {\n      console.error(\"Error loading cadence data:\", err);\n      setError(\n        err?.message ||\n          \"Error loading cadences. Backend cadence APIs may not be wired yet.\"\n      );\n      setSequences([]);\n      setSummary({\n        active_cadences: 0,\n        completed_cadences: 0,\n        todays_activities: 0,\n        overdue_activities: 0,\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const getStatusBadge = (seq: CadenceSequence) => {\n    const next = seq.next_touch_at ? new Date(seq.next_touch_at) : null;\n    const now = new Date();\n\n    if (!next) {\n      return (\n        <span className=\"inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs bg-slate-800 text-slate-200\">\n          <Clock className=\"w-3 h-3\" \/>\n          Scheduled\n        <\/span>\n      );\n    }\n\n    if (next.getTime() < now.getTime()) {\n      return (\n        <span className=\"inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs bg-red-900\/50 text-red-300\">\n          <AlertCircle className=\"w-3 h-3\" \/>\n          Overdue\n        <\/span>\n      );\n    }\n\n    const todayStr = now.toISOString().slice(0, 10);\n    const dateStr = next.toISOString().slice(0, 10);\n    if (todayStr === dateStr) {\n      return (\n        <span className=\"inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs bg-sky-900\/50 text-sky-300\">\n          <Clock className=\"w-3 h-3\" \/>\n          Due Today\n        <\/span>\n      );\n    }\n\n    return (\n      <span className=\"inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs bg-emerald-900\/40 text-emerald-300\">\n        <Clock className=\"w-3 h-3\" \/>\n        Upcoming\n      <\/span>\n    );\n  };\n\n  const formatDateTime = (value: string | null) => {\n    if (!value) return \"—\";\n    const d = new Date(value);\n    if (Number.isNaN(d.getTime())) return value;\n    return d.toLocaleString();\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {\/* Header *\/}\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h1 className=\"text-2xl md:text-3xl font-bold text-white\">\n            Cadence Control Center\n          <\/h1>\n          <p className=\"text-slate-400 mt-1 text-sm\">\n            See every touchpoint scheduled, what is overdue, and which\n            cadences are driving your pipeline.\n          <\/p>\n        <\/div>\n        <button\n          onClick={loadCadenceData}\n          disabled={loading}\n          className=\"inline-flex items-center gap-2 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-100 rounded-lg text-sm font-medium disabled:opacity-50\"\n        >\n          <RefreshCw\n            className={`w-4 h-4 ${loading ? \"animate-spin\" : \"\"}`}\n          \/>\n          Refresh\n        <\/button>\n      <\/div>\n\n      {\/* Error banner only if the API call itself fails *\/}\n      {error && (\n        <div className=\"bg-amber-900\/40 border border-amber-500\/60 text-amber-100 px-4 py-3 rounded-lg text-sm\">\n          <p className=\"font-semibold mb-1\">Cadence API Notice<\/p>\n          <p>{error}<\/p>\n          <p className=\"mt-1 text-xs text-amber-200\">\n            Once the cadence engine is wired to the database, this view will\n            populate with active sequences and scheduled activities.\n          <\/p>\n        <\/div>\n      )}\n\n      {\/* Metric cards *\/}\n      <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n        <div className=\"bg-slate-900\/70 border border-slate-800 rounded-xl p-4\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-semibold text-slate-400\">\n              Active Cadences\n            <\/span>\n            <Zap className=\"w-4 h-4 text-emerald-400\" \/>\n          <\/div>\n          <div className=\"text-3xl font-bold text-white\">\n            {summary.active_cadences}\n          <\/div>\n          <div className=\"text-xs text-slate-500 mt-1\">\n            Contacts currently on automated sequences.\n          <\/div>\n        <\/div>\n        <div className=\"bg-slate-900\/70 border border-slate-800 rounded-xl p-4\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-semibold text-slate-400\">\n              Completed Cadences\n            <\/span>\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" \/>\n          <\/div>\n          <div className=\"text-3xl font-bold text-white\">\n            {summary.completed_cadences}\n          <\/div>\n          <div className=\"text-xs text-slate-500 mt-1\">\n            Sequences that have fully run to completion.\n          <\/div>\n        <\/div>\n        <div className=\"bg-slate-900\/70 border border-slate-800 rounded-xl p-4\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-semibold text-slate-400\">\n              Today&apos;s Tasks\n            <\/span>\n            <Clock className=\"w-4 h-4 text-sky-400\" \/>\n          <\/div>\n          <div className=\"text-3xl font-bold text-white\">\n            {summary.todays_activities}\n          <\/div>\n          <div className=\"text-xs text-slate-500 mt-1\">\n            Emails, calls, and LinkedIn steps due today.\n          <\/div>\n        <\/div>\n        <div className=\"bg-slate-900\/70 border border-slate-800 rounded-xl p-4\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-xs font-semibold text-slate-400\">\n              Overdue Steps\n            <\/span>\n            <AlertCircle className=\"w-4 h-4 text-red-400\" \/>\n          <\/div>\n          <div className=\"text-3xl font-bold text-white\">\n            {summary.overdue_activities}\n          <\/div>\n          <div className=\"text-xs text-slate-500 mt-1\">\n            Tasks that slipped past their due date.\n          <\/div>\n        <\/div>\n      <\/div>\n\n      {\/* Active sequences table *\/}\n      <div className=\"bg-slate-900\/70 border border-slate-800 rounded-xl overflow-hidden\">\n        <div className=\"px-6 py-4 border-b border-slate-800 flex items-center justify-between\">\n          <h2 className=\"text-lg font-semibold text-white\">\n            Active Cadence Sequences\n          <\/h2>\n          <span className=\"text-xs text-slate-400\">\n            Pulled from \/api\/cadences\/active\n          <\/span>\n        <\/div>\n        <div className=\"overflow-x-auto\">\n          {loading ? (\n            <div className=\"p-6 text-center text-slate-400 text-sm\">\n              Loading cadence sequences…\n            <\/div>\n          ) : sequences.length === 0 ? (\n            <div className=\"p-6 text-center text-slate-400 text-sm\">\n              No active cadence sequences found yet. Start cadences for\n              contacts from your backend tools to see them here.\n            <\/div>\n          ) : (\n            <table className=\"min-w-full text-sm\">\n              <thead className=\"bg-slate-900 border-b border-slate-800\">\n                <tr>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Contact\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Cadence\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Progress\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Next Touch\n                  <\/th>\n                  <th className=\"px-4 py-3 text-left text-xs font-semibold text-slate-400\">\n                    Status\n                  <\/th>\n                <\/tr>\n              <\/thead>\n              <tbody className=\"divide-y divide-slate-800\">\n                {sequences.map((s) => (\n                  <tr key={s.id} className=\"hover:bg-slate-800\/60\">\n                    <td className=\"px-4 py-3\">\n                      <div className=\"font-semibold text-white\">\n                        {s.contact?.name}\n                      <\/div>\n                      <div className=\"text-xs text-slate-400\">\n                        {s.contact?.company || \"—\"}\n                      <\/div>\n                    <\/td>\n                    <td className=\"px-4 py-3 text-slate-200\">\n                      {s.cadence_type}\n                    <\/td>\n                    <td className=\"px-4 py-3 text-slate-200\">\n                      Step {s.current_step} of {s.total_steps}\n                    <\/td>\n                    <td className=\"px-4 py-3 text-slate-200\">\n                      {formatDateTime(s.next_touch_at)}\n                    <\/td>\n                    <td className=\"px-4 py-3\">{getStatusBadge(s)}<\/td>\n                  <\/tr>\n                ))}\n              <\/tbody>\n            <\/table>\n          )}\n        <\/div>\n      <\/div>\n    <\/div>\n  );\n}\nimport React, { useState } from 'react';\nimport {\n  X,\n  Edit2,\n  Save,\n  AlertTriangle,\n  Trash2,\n  User,\n  Building2,\n  Mail,\n  Linkedin,\n  Phone,\n  CheckCircle2,\n  XCircle,\n  Flag,\n  RotateCcw,\n  Info,\n  RefreshCw\n} from 'lucide-react';\n\ninterface Contact {\n  id: number;\n  name: string;\n  first_name?: string;\n  last_name?: string;\n  company: string | null;\n  email: string | null;\n  phone: string | null;\n  linkedin_url: string | null;\n  title?: string | null;\n  profile_picture_url?: string | null;\n  enrichment_status?: string;\n  lead_tier?: string;\n  opportunity_score?: number;\n}\n\ninterface Props {\n  contact: Contact;\n  onClose: () => void;\n  onUpdate: (contactId: number, updates: Partial<Contact>) => Promise<void>;\n  onFlag: (contactId: number, reason: string) => Promise<void>;\n  onRemove: (contactId: number) => Promise<void>;\n  onReEnrich: (contactId: number) => Promise<void>;\n}\n\nexport default function ContactDetailModal({ \n  contact, \n  onClose, \n  onUpdate, \n  onFlag, \n  onRemove,\n  onReEnrich \n}: Props) {\n  const [isEditing, setIsEditing] = useState(false);\n  const [isFlagging, setIsFlagging] = useState(false);\n  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);\n  const [flagReason, setFlagReason] = useState('');\n  const [saving, setSaving] = useState(false);\n\n  \/\/ Editable fields\n  const [editedData, setEditedData] = useState({\n    first_name: contact.first_name || '',\n    last_name: contact.last_name || '',\n    company: contact.company || '',\n    email: contact.email || '',\n    linkedin_url: contact.linkedin_url || ''\n  });\n\n  const handleSave = async () => {\n    setSaving(true);\n    try {\n      await onUpdate(contact.id, editedData);\n      setIsEditing(false);\n    } catch (error) {\n      console.error('Save failed:', error);\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleFlag = async () => {\n    if (!flagReason.trim()) return;\n    \n    setSaving(true);\n    try {\n      await onFlag(contact.id, flagReason);\n      setIsFlagging(false);\n      setFlagReason('');\n    } catch (error) {\n      console.error('Flag failed:', error);\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleRemove = async () => {\n    setSaving(true);\n    try {\n      await onRemove(contact.id);\n      onClose();\n    } catch (error) {\n      console.error('Remove failed:', error);\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleReEnrich = async () => {\n    setSaving(true);\n    try {\n      await onReEnrich(contact.id);\n      onClose();\n    } catch (error) {\n      console.error('Re-enrich failed:', error);\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleCancel = () => {\n    setEditedData({\n      first_name: contact.first_name || '',\n      last_name: contact.last_name || '',\n      company: contact.company || '',\n      email: contact.email || '',\n      linkedin_url: contact.linkedin_url || ''\n    });\n    setIsEditing(false);\n  };\n\n  const hasChanges = JSON.stringify(editedData) !== JSON.stringify({\n    first_name: contact.first_name || '',\n    last_name: contact.last_name || '',\n    company: contact.company || '',\n    email: contact.email || '',\n    linkedin_url: contact.linkedin_url || ''\n  });\n\n  return (\n    <div className=\"fixed inset-0 bg-black\/80 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-slate-800 rounded-2xl border border-slate-700 max-w-2xl w-full max-h-[90vh] overflow-y-auto\">\n        \n        {\/* Header *\/}\n        <div className=\"sticky top-0 bg-slate-800 border-b border-slate-700 px-6 py-4 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            {contact.profile_picture_url ? (\n              <img\n                src={contact.profile_picture_url}\n                alt={contact.name}\n                className=\"w-12 h-12 rounded-full\"\n              \/>\n            ) : (\n              <div className=\"w-12 h-12 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 flex items-center justify-center text-white font-bold text-lg\">\n                {contact.name.charAt(0)}\n              <\/div>\n            )}\n            <div>\n              <h2 className=\"text-xl font-bold text-white\">Contact Details<\/h2>\n              <p className=\"text-sm text-slate-400\">{contact.title || 'No title'}<\/p>\n            <\/div>\n          <\/div>\n          \n          <button\n            onClick={onClose}\n            className=\"p-2 hover:bg-slate-700 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5 text-slate-400\" \/>\n          <\/button>\n        <\/div>\n\n        {\/* Action Buttons *\/}\n        {!isEditing && !isFlagging && !showDeleteConfirm && (\n          <div className=\"px-6 py-4 bg-slate-900\/50 border-b border-slate-700\">\n            <div className=\"flex flex-wrap gap-2\">\n              <button\n                onClick={() => setIsEditing(true)}\n                className=\"flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-all\"\n              >\n                <Edit2 className=\"w-4 h-4\" \/>\n                Edit Contact\n              <\/button>\n              \n              <button\n                onClick={() => setIsFlagging(true)}\n                className=\"flex items-center gap-2 px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg font-medium transition-all\"\n              >\n                <Flag className=\"w-4 h-4\" \/>\n                Flag as Incorrect\n              <\/button>\n              \n              {contact.enrichment_status === 'complete' && (\n                <button\n                  onClick={handleReEnrich}\n                  disabled={saving}\n                  className=\"flex items-center gap-2 px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all disabled:opacity-50\"\n                >\n                  <RotateCcw className=\"w-4 h-4\" \/>\n                  Re-Enrich\n                <\/button>\n              )}\n              \n              <button\n                onClick={() => setShowDeleteConfirm(true)}\n                className=\"flex items-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-all ml-auto\"\n              >\n                <Trash2 className=\"w-4 h-4\" \/>\n                Remove Contact\n              <\/button>\n            <\/div>\n          <\/div>\n        )}\n\n        {\/* Delete Confirmation *\/}\n        {showDeleteConfirm && (\n          <div className=\"px-6 py-4 bg-red-900\/20 border-b border-red-700\">\n            <div className=\"flex items-start gap-3 mb-4\">\n              <AlertTriangle className=\"w-6 h-6 text-red-400 flex-shrink-0 mt-1\" \/>\n              <div>\n                <h3 className=\"text-lg font-bold text-white mb-1\">Confirm Removal<\/h3>\n                <p className=\"text-sm text-slate-300\">\n                  Are you sure you want to permanently remove <strong>{contact.name}<\/strong>? \n                  This action cannot be undone and will delete all associated enrichment data.\n                <\/p>\n              <\/div>\n            <\/div>\n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleRemove}\n                disabled={saving}\n                className=\"px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-all disabled:opacity-50\"\n              >\n                {saving ? 'Removing...' : 'Yes, Remove Contact'}\n              <\/button>\n              <button\n                onClick={() => setShowDeleteConfirm(false)}\n                disabled={saving}\n                className=\"px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg font-medium transition-all\"\n              >\n                Cancel\n              <\/button>\n            <\/div>\n          <\/div>\n        )}\n\n        {\/* Flag Form *\/}\n        {isFlagging && (\n          <div className=\"px-6 py-4 bg-yellow-900\/20 border-b border-yellow-700\">\n            <div className=\"flex items-start gap-3 mb-4\">\n              <Flag className=\"w-6 h-6 text-yellow-400 flex-shrink-0 mt-1\" \/>\n              <div className=\"flex-1\">\n                <h3 className=\"text-lg font-bold text-white mb-1\">Flag Incorrect Information<\/h3>\n                <p className=\"text-sm text-slate-300 mb-3\">\n                  Please describe what information is incorrect or needs updating. Your feedback helps improve data quality.\n                <\/p>\n                \n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-sm font-medium text-slate-300 mb-1\">\n                      What's wrong?\n                    <\/label>\n                    <textarea\n                      value={flagReason}\n                      onChange={(e) => setFlagReason(e.target.value)}\n                      placeholder=\"e.g., 'Wrong LinkedIn profile - this person changed companies' or 'Email bounced - needs verification'\"\n                      className=\"w-full px-3 py-2 bg-slate-800 border border-slate-600 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-yellow-500 resize-none\"\n                      rows={3}\n                    \/>\n                  <\/div>\n                  \n                  <div className=\"text-xs text-slate-400 flex items-start gap-2\">\n                    <Info className=\"w-4 h-4 flex-shrink-0 mt-0.5\" \/>\n                    <span>\n                      After flagging, the contact will be marked for review. You can still edit the information directly if you know the correct details.\n                    <\/span>\n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n            \n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleFlag}\n                disabled={!flagReason.trim() || saving}\n                className=\"px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed\"\n              >\n                {saving ? 'Flagging...' : 'Submit Flag'}\n              <\/button>\n              <button\n                onClick={() => {\n                  setIsFlagging(false);\n                  setFlagReason('');\n                }}\n                disabled={saving}\n                className=\"px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg font-medium transition-all\"\n              >\n                Cancel\n              <\/button>\n            <\/div>\n          <\/div>\n        )}\n\n        {\/* Contact Information *\/}\n        <div className=\"px-6 py-6\">\n          <div className=\"space-y-4\">\n            \n            {\/* First Name *\/}\n            <div>\n              <label className=\"flex items-center gap-2 text-sm font-medium text-slate-400 mb-2\">\n                <User className=\"w-4 h-4\" \/>\n                First Name\n              <\/label>\n              {isEditing ? (\n                <input\n                  type=\"text\"\n                  value={editedData.first_name}\n                  onChange={(e) => setEditedData({ ...editedData, first_name: e.target.value })}\n                  className=\"w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  placeholder=\"Enter first name\"\n                \/>\n              ) : (\n                <p className=\"text-white text-lg\">{contact.first_name || '—'}<\/p>\n              )}\n            <\/div>\n\n            {\/* Last Name *\/}\n            <div>\n              <label className=\"flex items-center gap-2 text-sm font-medium text-slate-400 mb-2\">\n                <User className=\"w-4 h-4\" \/>\n                Last Name\n              <\/label>\n              {isEditing ? (\n                <input\n                  type=\"text\"\n                  value={editedData.last_name}\n                  onChange={(e) => setEditedData({ ...editedData, last_name: e.target.value })}\n                  className=\"w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  placeholder=\"Enter last name\"\n                \/>\n              ) : (\n                <p className=\"text-white text-lg\">{contact.last_name || '—'}<\/p>\n              )}\n            <\/div>\n\n            {\/* Company *\/}\n            <div>\n              <label className=\"flex items-center gap-2 text-sm font-medium text-slate-400 mb-2\">\n                <Building2 className=\"w-4 h-4\" \/>\n                Company\n              <\/label>\n              {isEditing ? (\n                <input\n                  type=\"text\"\n                  value={editedData.company}\n                  onChange={(e) => setEditedData({ ...editedData, company: e.target.value })}\n                  className=\"w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  placeholder=\"Enter company name\"\n                \/>\n              ) : (\n                <p className=\"text-white text-lg\">{contact.company || '—'}<\/p>\n              )}\n            <\/div>\n\n            {\/* Email *\/}\n            <div>\n              <label className=\"flex items-center gap-2 text-sm font-medium text-slate-400 mb-2\">\n                <Mail className=\"w-4 h-4\" \/>\n                Email\n              <\/label>\n              {isEditing ? (\n                <input\n                  type=\"email\"\n                  value={editedData.email}\n                  onChange={(e) => setEditedData({ ...editedData, email: e.target.value })}\n                  className=\"w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  placeholder=\"Enter email address\"\n                \/>\n              ) : (\n                <a \n                  href={`mailto:${contact.email}`}\n                  className=\"text-blue-400 hover:text-blue-300 text-lg\"\n                >\n                  {contact.email || '—'}\n                <\/a>\n              )}\n            <\/div>\n\n    