t-slate-400\">\n                {hasChanges && (\n                  <>\n                    <AlertTriangle className=\"w-4 h-4 text-yellow-400\" \/>\n                    <span>You have unsaved changes<\/span>\n                  <\/>\n                )}\n              <\/div>\n              \n              <div className=\"flex gap-2\">\n                <button\n                  onClick={handleCancel}\n                  disabled={saving}\n                  className=\"px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg font-medium transition-all flex items-center gap-2\"\n                >\n                  <XCircle className=\"w-4 h-4\" \/>\n                  Cancel\n                <\/button>\n                <button\n                  onClick={handleSave}\n                  disabled={!hasChanges || saving}\n                  className=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-all flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed\"\n                >\n                  {saving ? (\n                    <>\n                      <RefreshCw className=\"w-4 h-4 animate-spin\" \/>\n                      Saving...\n                    <\/>\n                  ) : (\n                    <>\n                      <CheckCircle2 className=\"w-4 h-4\" \/>\n                      Save Changes\n                    <\/>\n                  )}\n                <\/button>\n              <\/div>\n            <\/div>\n          <\/div>\n        )}\n\n        {\/* Info Footer *\/}\n        {!isEditing && !isFlagging && !showDeleteConfirm && (\n          <div className=\"px-6 py-4 bg-slate-900\/50 border-t border-slate-700\">\n            <div className=\"flex items-start gap-2 text-xs text-slate-400\">\n              <Info className=\"w-4 h-4 flex-shrink-0 mt-0.5\" \/>\n              <div>\n                <p className=\"mb-1\">\n                  <strong className=\"text-slate-300\">Edit Contact:<\/strong>